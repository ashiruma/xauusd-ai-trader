<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>XAUUSD Quantitative Trading Terminal</title>
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- TradingView Lightweight Charts v4.2.0 CDN -->
    <script src="https://unpkg.com/lightweight-charts@4.2.0/dist/lightweight-charts.standalone.production.js"></script>
    <style>
        :root {
            --bg-base: #080b11;
            --bg-surface-1: #0e131f;
            --bg-surface-2: #141a29;
            --bg-surface-3: #1b2336;
            --border-subtle: rgba(255, 255, 255, 0.05);
            --border-default: rgba(255, 255, 255, 0.09);
            --border-hover: rgba(255, 255, 255, 0.16);
            --border-focus: #3b82f6;

            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;

            --accent-gold: #d4af37;
            --accent-gold-subtle: rgba(212, 175, 55, 0.12);
            --accent-green: #10b981;
            --accent-green-subtle: rgba(16, 185, 129, 0.12);
            --accent-green-border: rgba(16, 185, 129, 0.25);
            --accent-red: #ef4444;
            --accent-red-subtle: rgba(239, 68, 68, 0.12);
            --accent-red-border: rgba(239, 68, 68, 0.25);
            --accent-blue: #3b82f6;
            --accent-blue-subtle: rgba(59, 130, 246, 0.12);
            --accent-amber: #f59e0b;
            --accent-amber-subtle: rgba(245, 158, 11, 0.12);

            --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --radius-sm: 4px;
            --radius-md: 6px;
            --radius-lg: 8px;
            --radius-xl: 12px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-primary);
            font-family: var(--font-sans);
            font-size: 13px;
            line-height: 1.5;
            padding: 16px;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        .mono-nums {
            font-family: var(--font-mono);
            font-feature-settings: "tnum" 1, "zero" 1;
        }

        /* Top Header Navigation */
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 20px;
            background: var(--bg-surface-1);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-lg);
            margin-bottom: 14px;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .brand-title-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-logo-icon {
            width: 24px;
            height: 24px;
            color: var(--accent-gold);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .brand-title {
            font-size: 15px;
            font-weight: 800;
            letter-spacing: 0.8px;
            color: var(--text-primary);
            text-transform: uppercase;
        }

        .brand-tag {
            font-size: 10px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: var(--radius-sm);
            background: var(--accent-gold-subtle);
            color: var(--accent-gold);
            border: 1px solid rgba(212, 175, 55, 0.25);
            letter-spacing: 0.5px;
        }

        .navbar-badges {
            display: flex;
            align-items: center;
            gap: 8px;
            border-left: 1px solid var(--border-subtle);
            padding-left: 16px;
        }

        .badge {
            font-size: 11px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: var(--radius-sm);
            letter-spacing: 0.3px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-transform: uppercase;
        }

        .badge-live {
            background: var(--accent-green-subtle);
            color: var(--accent-green);
            border: 1px solid var(--accent-green-border);
        }

        .badge-paper {
            background: var(--accent-blue-subtle);
            color: var(--accent-blue);
            border: 1px solid rgba(59, 130, 246, 0.25);
        }

        .badge-account-pill {
            background: var(--bg-surface-2);
            color: var(--text-primary);
            border: 1px solid var(--border-default);
            cursor: pointer;
            transition: all 0.15s ease;
            font-family: var(--font-mono);
            font-size: 11px;
        }

        .badge-account-pill:hover {
            border-color: var(--accent-gold);
            color: var(--accent-gold);
        }

        .badge-ws-online {
            background: var(--accent-green-subtle);
            color: var(--accent-green);
            border: 1px solid var(--accent-green-border);
        }

        .badge-ws-offline {
            background: var(--accent-red-subtle);
            color: var(--accent-red);
            border: 1px solid var(--accent-red-border);
        }

        .badge-ws-recon {
            background: var(--accent-amber-subtle);
            color: var(--accent-amber);
            border: 1px solid rgba(245, 158, 11, 0.25);
        }

        .badge-data {
            background: var(--bg-surface-2);
            color: var(--text-secondary);
            border: 1px solid var(--border-subtle);
        }

        .navbar-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn {
            font-family: var(--font-sans);
            font-size: 12px;
            font-weight: 600;
            padding: 8px 16px;
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: all 0.15s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: 1px solid transparent;
            text-decoration: none;
            outline: none;
        }

        .btn-primary {
            background: #047857;
            color: #ffffff;
            border-color: #059669;
        }

        .btn-primary:hover {
            background: #059669;
        }

        .btn-primary:active {
            transform: translateY(1px);
        }

        .btn-secondary {
            background: var(--bg-surface-2);
            color: var(--text-primary);
            border-color: var(--border-default);
        }

        .btn-secondary:hover {
            background: var(--bg-surface-3);
            border-color: var(--border-hover);
        }

        .btn-danger-outline {
            background: var(--accent-red-subtle);
            color: var(--accent-red);
            border-color: var(--accent-red-border);
        }

        .btn-danger-outline:hover {
            background: #dc2626;
            color: #ffffff;
            border-color: #dc2626;
        }

        .btn-resume {
            background: #059669;
            color: #ffffff;
            border-color: #10b981;
        }

        .btn-resume:hover {
            background: #10b981;
        }

        /* Warning Banner */
        .alert-banner {
            display: none;
            align-items: center;
            justify-content: space-between;
            background: #450a0a;
            color: #fecaca;
            border: 1px solid #991b1b;
            padding: 10px 18px;
            border-radius: var(--radius-md);
            margin-bottom: 14px;
            font-size: 12px;
        }

        .alert-banner kbd {
            background: #2a0808;
            padding: 2px 6px;
            border-radius: 3px;
            border: 1px solid #f87171;
            font-family: var(--font-mono);
            font-size: 11px;
            color: #fff;
        }

        /* Account Overview Summary Grid */
        .account-overview-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 12px;
            margin-bottom: 14px;
        }

        .account-metric-card {
            background: var(--bg-surface-1);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-lg);
            padding: 14px 18px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: border-color 0.15s ease;
        }

        .account-metric-card:hover {
            border-color: var(--border-hover);
        }

        .metric-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
        }

        .metric-title {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            color: var(--text-muted);
            letter-spacing: 0.5px;
        }

        .metric-icon {
            width: 14px;
            height: 14px;
            color: var(--text-muted);
        }

        .metric-value {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-primary);
            font-family: var(--font-mono);
            margin-bottom: 4px;
            letter-spacing: -0.5px;
        }

        .metric-subtext {
            font-size: 11px;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* Market & Technical Ticker Ribbon */
        .market-ribbon-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 12px;
            margin-bottom: 14px;
        }

        .ribbon-item-card {
            background: var(--bg-surface-1);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-lg);
            padding: 12px 16px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .ribbon-label {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

        .ribbon-primary-val {
            font-size: 16px;
            font-weight: 700;
            font-family: var(--font-mono);
            color: var(--text-primary);
        }

        .ribbon-secondary-val {
            font-size: 11px;
            font-family: var(--font-mono);
            color: var(--text-secondary);
        }

        .val-bull { color: var(--accent-green) !important; }
        .val-bear { color: var(--accent-red) !important; }
        .val-gold { color: var(--accent-gold) !important; }
        .val-blue { color: var(--accent-blue) !important; }

        /* Workspace Grid: Chart (Left) + AI & Risk Panel (Right) */
        .workspace-split-grid {
            display: grid;
            grid-template-columns: minmax(0, 72%) minmax(0, 28%);
            gap: 14px;
            margin-bottom: 14px;
        }

        /* Chart Panel */
        .chart-container-card {
            background: var(--bg-surface-1);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-lg);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 18px;
            background: var(--bg-surface-2);
            border-bottom: 1px solid var(--border-default);
        }

        .chart-title-area {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .chart-symbol-badge {
            font-size: 13px;
            font-weight: 800;
            color: var(--text-primary);
            letter-spacing: 0.4px;
        }

        .timeframe-pills {
            display: flex;
            gap: 4px;
            background: var(--bg-surface-1);
            padding: 2px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-subtle);
        }

        .tf-pill {
            padding: 2px 8px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            border-radius: 3px;
            cursor: pointer;
            border: none;
            background: transparent;
        }

        .tf-pill.active {
            background: var(--bg-surface-3);
            color: var(--accent-gold);
        }

        .chart-legend-area {
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 11px;
            font-family: var(--font-mono);
        }

        .legend-tag {
            display: flex;
            align-items: center;
            gap: 5px;
            color: var(--text-secondary);
        }

        .legend-indicator-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        #candlestick-chart {
            width: 100%;
            height: 400px;
            position: relative;
        }

        /* AI & Risk Sidebar Panel */
        .side-command-column {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .command-card {
            background: var(--bg-surface-1);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-lg);
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .command-card-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-subtle);
            padding-bottom: 8px;
        }

        .card-heading {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .ai-metrics-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .ai-metric-item {
            background: var(--bg-surface-2);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            padding: 8px 12px;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .ai-metric-label {
            font-size: 10px;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 600;
        }

        .ai-metric-val {
            font-size: 13px;
            font-weight: 700;
            font-family: var(--font-mono);
            color: var(--text-primary);
        }

        .confidence-gauge-wrap {
            display: flex;
            flex-direction: column;
            gap: 4px;
            margin-top: 4px;
        }

        .confidence-bar-bg {
            width: 100%;
            height: 6px;
            background: var(--bg-surface-3);
            border-radius: 3px;
            overflow: hidden;
        }

        .confidence-bar-fill {
            height: 100%;
            background: var(--accent-green);
            width: 0%;
            transition: width 0.3s ease;
        }

        .safeguard-row-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 6px 0;
            border-bottom: 1px solid var(--border-subtle);
            font-size: 11px;
        }

        .safeguard-row-item:last-child {
            border-bottom: none;
        }

        .safeguard-title {
            color: var(--text-secondary);
        }

        .safeguard-status {
            font-family: var(--font-mono);
            font-weight: 600;
            color: var(--text-primary);
        }

        /* Bottom Tabbed Workspace Pane */
        .bottom-workspace-card {
            background: var(--bg-surface-1);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-lg);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-height: 300px;
        }

        .tab-navigation-bar {
            display: flex;
            background: var(--bg-surface-2);
            border-bottom: 1px solid var(--border-default);
        }

        .tab-btn {
            background: transparent;
            color: var(--text-muted);
            border: none;
            padding: 12px 22px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            transition: all 0.15s ease;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .tab-btn:hover {
            color: var(--text-primary);
            background: rgba(255, 255, 255, 0.02);
        }

        .tab-btn.active {
            color: var(--accent-gold);
            border-bottom-color: var(--accent-gold);
            background: var(--bg-surface-1);
        }

        .tab-content {
            display: none;
            padding: 16px 20px;
            flex: 1;
        }

        .tab-content.active {
            display: block;
        }

        /* Data Tables */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            text-align: left;
        }

        .data-table th {
            color: var(--text-muted);
            font-weight: 600;
            padding: 10px 14px;
            border-bottom: 1px solid var(--border-default);
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 0.5px;
            background: var(--bg-surface-2);
        }

        .data-table td {
            padding: 10px 14px;
            border-bottom: 1px solid var(--border-subtle);
            font-family: var(--font-mono);
            color: var(--text-primary);
        }

        .data-table tr:hover td {
            background: rgba(255, 255, 255, 0.02);
        }

        .pill-tag {
            font-size: 10px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 3px;
            display: inline-block;
        }

        .btn-table-action {
            background: var(--accent-red-subtle);
            color: var(--accent-red);
            border: 1px solid var(--accent-red-border);
            padding: 4px 10px;
            font-size: 11px;
            font-weight: 600;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .btn-table-action:hover {
            background: #ef4444;
            color: #ffffff;
        }

        /* Performance Analytics Tab */
        .analytics-metrics-strip {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 12px;
            margin-bottom: 16px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border-default);
        }

        #equity-chart-container {
            width: 100%;
            height: 240px;
        }

        /* Risk Governance Tab */
        .risk-telemetry-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
            margin-bottom: 16px;
        }

        .risk-gauge-box {
            background: var(--bg-surface-2);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-md);
            padding: 14px 16px;
        }

        .risk-gauge-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .risk-progress-bg {
            width: 100%;
            height: 8px;
            background: var(--bg-surface-3);
            border-radius: 4px;
            overflow: hidden;
            margin-top: 6px;
        }

        .risk-progress-bar {
            height: 100%;
            background: var(--accent-green);
            border-radius: 4px;
            transition: width 0.3s ease;
        }

        /* Modals */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(4, 6, 10, 0.82);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            backdrop-filter: blur(6px);
        }

        .modal-dialog {
            background: var(--bg-surface-1);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-xl);
            width: 580px;
            max-width: 92vw;
            max-height: 88vh;
            overflow-y: auto;
            padding: 24px;
            box-shadow: 0 24px 48px rgba(0, 0, 0, 0.7);
        }

        .modal-header-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 1px solid var(--border-default);
            padding-bottom: 14px;
            margin-bottom: 18px;
        }

        .modal-title-wrap h3 {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .modal-title-wrap p {
            font-size: 12px;
            color: var(--text-secondary);
        }

        .modal-close-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 20px;
            cursor: pointer;
            padding: 2px 6px;
            line-height: 1;
            transition: color 0.15s ease;
        }

        .modal-close-btn:hover {
            color: var(--text-primary);
        }

        /* Modal Steps & Form */
        .modal-step-section {
            margin-bottom: 18px;
        }

        .step-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--text-muted);
            letter-spacing: 0.5px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .form-group {
            margin-bottom: 14px;
        }

        .form-label {
            display: block;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.3px;
            margin-bottom: 6px;
        }

        .input-wrap-with-toggle {
            position: relative;
            display: flex;
            align-items: center;
        }

        .form-input {
            width: 100%;
            background: var(--bg-surface-2);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-md);
            padding: 10px 14px;
            color: var(--text-primary);
            font-family: var(--font-mono);
            font-size: 13px;
            outline: none;
            transition: all 0.15s ease;
        }

        .form-input:focus {
            border-color: var(--border-focus);
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
            background: var(--bg-surface-1);
        }

        .password-toggle-btn {
            position: absolute;
            right: 10px;
            background: transparent;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            padding: 4px 8px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .password-toggle-btn:hover {
            color: var(--text-primary);
        }

        .form-select {
            width: 100%;
            background: var(--bg-surface-2);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-md);
            padding: 10px 14px;
            color: var(--text-primary);
            font-size: 13px;
            outline: none;
            transition: all 0.15s ease;
        }

        .form-select:focus {
            border-color: var(--border-focus);
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }

        /* Requirement Compact Info Card */
        .requirement-info-card {
            background: var(--accent-gold-subtle);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: var(--radius-md);
            padding: 12px 16px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            margin-bottom: 16px;
        }

        .requirement-info-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .requirement-info-title {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--accent-gold);
            letter-spacing: 0.4px;
        }

        .requirement-info-amount {
            font-size: 13px;
            font-weight: 800;
            font-family: var(--font-mono);
            color: var(--accent-gold);
        }

        .requirement-info-desc {
            font-size: 11px;
            color: var(--text-secondary);
            line-height: 1.4;
        }

        /* Execution Safeguards Rows */
        .safeguards-box {
            background: var(--bg-surface-2);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-md);
            padding: 8px 14px;
            margin-bottom: 18px;
        }

        .modal-safeguard-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid var(--border-subtle);
        }

        .modal-safeguard-row:last-child {
            border-bottom: none;
        }

        .safeguard-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .safeguard-info-title {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .safeguard-info-desc {
            font-size: 11px;
            color: var(--text-muted);
        }

        /* Alert Callout */
        .modal-alert-box {
            display: none;
            padding: 12px 16px;
            border-radius: var(--radius-md);
            font-size: 12px;
            margin-bottom: 18px;
            line-height: 1.4;
        }

        .modal-footer-row {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 12px;
            padding-top: 10px;
            border-top: 1px solid var(--border-default);
        }

        /* Audit Lineage Modal */
        .lineage-step-card {
            background: var(--bg-surface-2);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-md);
            padding: 12px 16px;
            margin-bottom: 10px;
        }

        .lineage-step-header {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
        }

        .lineage-step-content {
            font-family: var(--font-mono);
            font-size: 11px;
            color: var(--text-primary);
            white-space: pre-wrap;
            word-break: break-all;
            line-height: 1.5;
        }

        /* Responsive Breakpoints */
        @media (max-width: 1400px) {
            .account-overview-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            .market-ribbon-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            .workspace-split-grid {
                grid-template-columns: minmax(0, 68%) minmax(0, 32%);
            }
        }

        @media (max-width: 1024px) {
            .workspace-split-grid {
                grid-template-columns: 1fr;
            }
            .account-overview-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .market-ribbon-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .risk-telemetry-grid {
                grid-template-columns: 1fr;
            }
            .analytics-metrics-strip {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 640px) {
            body {
                padding: 8px;
            }
            .navbar {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }
            .navbar-actions {
                width: 100%;
                justify-content: space-between;
            }
            .account-overview-grid {
                grid-template-columns: 1fr;
            }
            .market-ribbon-grid {
                grid-template-columns: 1fr;
            }
            .analytics-metrics-strip {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
