                    horzLines: { color: 'rgba(255, 255, 255, 0.04)' },
                },
                crosshair: {
                    mode: LightweightCharts.CrosshairMode.Normal,
                },
                rightPriceScale: {
                    borderColor: 'rgba(255, 255, 255, 0.08)',
                    scaleMargins: {
                        top: 0.1,
                        bottom: 0.1,
                    },
                },
                timeScale: {
                    borderColor: 'rgba(255, 255, 255, 0.08)',
                    timeVisible: true,
                    secondsVisible: false,
                    rightOffset: 12,
                    barSpacing: 6,
                },
            });

            candleSeries = candleChart.addCandlestickSeries({
                upColor: '#10b981',
                downColor: '#ef4444',
                borderUpColor: '#10b981',
                borderDownColor: '#ef4444',
                wickUpColor: '#10b981',
                wickDownColor: '#ef4444',
            });

            // EMA Series
            ema9Series = candleChart.addLineSeries({ color: '#06b6d4', lineWidth: 1, title: 'EMA 9' });
            ema21Series = candleChart.addLineSeries({ color: '#f59e0b', lineWidth: 2, title: 'EMA 21' });
            ema50Series = candleChart.addLineSeries({ color: '#3b82f6', lineWidth: 2, title: 'EMA 50' });
            ema200Series = candleChart.addLineSeries({ color: '#8b5cf6', lineWidth: 2, title: 'EMA 200' });

            // Initialize Equity Chart in Tab 2
            const eqElement = document.getElementById('equity-chart-container');
            equityChart = LightweightCharts.createChart(eqElement, {
                layout: { background: { color: '#0e131f' }, textColor: '#94a3b8' },
                grid: { vertLines: { color: 'rgba(255, 255, 255, 0.04)' }, horzLines: { color: 'rgba(255, 255, 255, 0.04)' } },
                rightPriceScale: { borderColor: 'rgba(255, 255, 255, 0.08)' },
                timeScale: { borderColor: 'rgba(255, 255, 255, 0.08)', timeVisible: true },
            });
            equityAreaSeries = equityChart.addAreaSeries({
                topColor: 'rgba(16, 185, 129, 0.35)',
                bottomColor: 'rgba(16, 185, 129, 0.01)',
                lineColor: '#10b981',
                lineWidth: 2,
            });

            // Responsive chart resize observer
            if (window.ResizeObserver) {
                const resizeObserver = new ResizeObserver(entries => {
                    for (let entry of entries) {
                        if (entry.target === chartElement && candleChart) {
                            candleChart.applyOptions({ width: chartElement.clientWidth });
                        } else if (entry.target === eqElement && equityChart) {
                            equityChart.applyOptions({ width: eqElement.clientWidth });
                        }
                    }
                });
                resizeObserver.observe(chartElement);
                if (eqElement) resizeObserver.observe(eqElement);
            }

            window.addEventListener('resize', () => {
                if (candleChart && chartElement) candleChart.applyOptions({ width: chartElement.clientWidth });
                if (equityChart && eqElement) equityChart.applyOptions({ width: eqElement.clientWidth });
            });
        }

        // Tab Switching
        function switchTab(tabId) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            if (event && event.target) {
                event.target.closest('.tab-btn').classList.add('active');
            }
            const targetEl = document.getElementById(tabId);
            if (targetEl) targetEl.classList.add('active');

            if (tabId === 'tab-analytics') {
                setTimeout(() => {
                    equityChart.applyOptions({ width: document.getElementById('equity-chart-container').clientWidth });
                    equityChart.timeScale().fitContent();
                }, 50);
            } else if (tabId === 'tab-journal') {
                loadJournal();
            }
        }

        // Load Initial Historical Candles
        async function loadHistoricalCandles(tf = 'M15') {
            try {
                window.currentChartTimeframe = tf;
                const tfIntervals = { 'M1': 60, 'M5': 300, 'M15': 900, 'H1': 3600, 'H4': 14400 };
                window.currentTimeframeSeconds = tfIntervals[tf] || 900;

                const res = await fetch(`/api/candles/history?timeframe=${encodeURIComponent(tf)}&count=250`);
                const data = await res.json();
                if (data.candles && data.candles.length > 0) {
                    // Strictly sort ascending and deduplicate timestamps
                    const cleanCandles = [];
                    const sorted = data.candles.slice().sort((a, b) => a.time - b.time);
                    let lastTime = 0;
                    for (const c of sorted) {
                        if (c.time && c.time > lastTime && !isNaN(c.open) && !isNaN(c.close) && !isNaN(c.high) && !isNaN(c.low)) {
                            cleanCandles.push({
                                time: c.time,
                                open: c.open,
                                high: c.high,
                                low: c.low,
                                close: c.close
                            });
                            lastTime = c.time;
                        }
                    }

                    if (cleanCandles.length > 0) {
                        candleSeries.setData(cleanCandles);
                        const lastBar = cleanCandles[cleanCandles.length - 1];
                        window.lastHistoricalBarTime = lastBar.time;
                        window.activeCandle = {
                            time: lastBar.time,
                            open: lastBar.open,
                            high: lastBar.high,
                            low: lastBar.low,
                            close: lastBar.close
                        };

                        const closes = cleanCandles.map(c => c.close);
                        const calcEma = (period) => {
                            const k = 2 / (period + 1);
                            let ema = closes[0];
                            return cleanCandles.map((c, i) => {
                                if (i === 0) ema = c.close;
                                else ema = c.close * k + ema * (1 - k);
                                return { time: c.time, value: parseFloat(ema.toFixed(2)) };
                            });
                        };

                        if (ema9Series) ema9Series.setData(calcEma(9));
                        if (ema21Series) ema21Series.setData(calcEma(21));
                        if (ema50Series) ema50Series.setData(calcEma(50));
                        if (ema200Series) ema200Series.setData(calcEma(200));

                        candleChart.timeScale().fitContent();
                    }
                }
            } catch (err) {
                console.error("Failed to load historical candles:", err);
            }
        }

        let wsPingInterval = null;

        // Connect WebSocket
        function connectWebSocket() {
            const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
            const wsUrl = `${protocol}//${window.location.host}/ws/terminal`;
            const badgeWs = document.getElementById('badge-ws');

            badgeWs.innerText = 'CONNECTING';
            badgeWs.className = 'badge badge-ws-recon';

            if (wsPingInterval) {
                clearInterval(wsPingInterval);
                wsPingInterval = null;
            }

            ws = new WebSocket(wsUrl);

            ws.onopen = () => {
                badgeWs.innerText = 'CONNECTED';
                badgeWs.className = 'badge badge-ws-online';

                // Keepalive heartbeat every 10s to prevent disconnects
                wsPingInterval = setInterval(() => {
                    if (ws && ws.readyState === WebSocket.OPEN) {
                        ws.send("ping");
                    }
                }, 10000);
            };

            ws.onmessage = (event) => {
                if (event.data === "pong") return;
                try {
                    const data = JSON.parse(event.data);
                    handleTelemetry(data);
                } catch (e) {
                    console.error("WS Parse error:", e);
                }
            };

            ws.onclose = () => {
                if (wsPingInterval) {
                    clearInterval(wsPingInterval);
                    wsPingInterval = null;
                }
                badgeWs.innerText = 'RECONNECTING';
                badgeWs.className = 'badge badge-ws-recon';
                setTimeout(connectWebSocket, 2000);
            };

            ws.onerror = (err) => {
                console.error("WebSocket error:", err);
                badgeWs.innerText = 'DISCONNECTED';
                badgeWs.className = 'badge badge-ws-offline';
                ws.close();
            };
        }

        // Handle Incoming WebSocket Messages
        function handleTelemetry(msg) {
            try {
                if (msg.type === 'INITIAL_STATE') {
                    if (msg.status) updateStatusUI(msg.status);
                    if (msg.market_state) updateMarketStateUI(msg.market_state);
                    if (msg.positions) updatePositionsUI(msg.positions);
                    if (msg.fused_signal) updateSignalUI(msg.fused_signal);
                } else if (msg.type === 'TICK_STEP') {
                    if (msg.market_state) updateMarketStateUI(msg.market_state);
                    if (msg.open_positions) updatePositionsUI(msg.open_positions);
                    if (msg.fused_signal) updateSignalUI(msg.fused_signal);
                } else if (msg.type === 'POSITION_CLOSED') {
                    loadPositions();
                    loadJournal();
                    loadPerformance();
                } else if (msg.type === 'ACCOUNT_CONNECTED') {
                    loadAccountInfo();
                }
            } catch (err) {
                console.error("handleTelemetry error:", err);
            }
        }

        // Periodic Algo Trading Status Poller
        async function checkAlgoStatus() {
            try {
                const res = await fetch('/api/algo-trading/status');
                const data = await res.json();
                const algoBanner = document.getElementById('banner-algo-trading');
                const brokerStatus = document.getElementById('broker-status');
                if (data.algo_trading_allowed) {
                    if (algoBanner) algoBanner.style.display = 'none';
                    if (brokerStatus && data.mt5_connected) {
                        brokerStatus.innerText = 'Live & Trading Active';
                        brokerStatus.className = 'ribbon-primary-val val-bull';
                    }
                } else {
                    if (algoBanner) algoBanner.style.display = 'flex';
                    if (brokerStatus && data.mt5_connected) {
                        brokerStatus.innerText = 'MT5 Connected (Algo OFF)';
                        brokerStatus.className = 'ribbon-primary-val val-gold';
                    }
                }
            } catch (e) {
                console.debug("Algo status check error:", e);
            }
        }

        // UI Updates
        function updateStatusUI(status) {
            document.getElementById('badge-mode').innerText = status.trading_mode + ' MODE';
            document.getElementById('badge-mode').className = 'badge ' + (status.trading_mode === 'LIVE' ? 'badge-live' : 'badge-paper');
            document.getElementById('badge-data').innerText = 'DATA: ' + status.data_mode;

            let aiText = 'AI: ' + status.ai_provider;
            let aiDisplayModel = status.ai_provider;
            if (status.ai_provider === 'DeterministicMockProvider') {
                aiText = 'AI: Gemini (Rule Fallback)';
                aiDisplayModel = 'Gemini (Rule Fallback)';
            }
            document.getElementById('badge-ai').innerText = aiText;
            const aiProviderEl = document.getElementById('ai-provider-name');
            if (aiProviderEl) aiProviderEl.innerText = aiDisplayModel;

            // Account Balance & Equity Overview
            if (status.account) {
                const acc = status.account;
                const balEl = document.getElementById('acc-balance');
                const eqEl = document.getElementById('acc-equity');
                const mfEl = document.getElementById('acc-margin-free');
                const fpnlEl = document.getElementById('acc-floating-pnl');
                const marginSub = document.getElementById('acc-margin-sub');

                if (balEl && acc.balance !== undefined) balEl.innerText = '$' + acc.balance.toFixed(2);
                if (eqEl && acc.equity !== undefined) eqEl.innerText = '$' + acc.equity.toFixed(2);
                if (mfEl && acc.margin_free !== undefined) mfEl.innerText = '$' + acc.margin_free.toFixed(2);

                if (fpnlEl && acc.equity !== undefined && acc.balance !== undefined) {
                    const diff = acc.equity - acc.balance;
                    fpnlEl.innerText = (diff >= 0 ? '+$' : '-$') + Math.abs(diff).toFixed(2);
                    fpnlEl.className = 'metric-value ' + (diff >= 0 ? 'val-bull' : 'val-bear');
                }

                if (marginSub && acc.balance && acc.margin_free !== undefined) {
                    const used = Math.max(0, acc.balance - acc.margin_free);
                    if (used > 0) {
                        const level = (acc.equity / used) * 100;
                        marginSub.innerText = `Margin Level: ${level.toFixed(0)}% (Used: $${used.toFixed(2)})`;
                    } else {
                        marginSub.innerText = 'Margin Level: 100% (No Margin Used)';
                    }
                }
            }

            // Algo trading banner update
