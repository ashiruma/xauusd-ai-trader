            document.querySelectorAll('.tf-pill').forEach(btn => {
                btn.addEventListener('click', async () => {
                    document.querySelectorAll('.tf-pill').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    const tf = btn.innerText.trim();
                    await loadHistoricalCandles(tf);
                });
            });

            await loadHistoricalCandles('M15');
            connectWebSocket();
            checkAlgoStatus();
            loadAccountInfo();
            // Polling interval for regular status sync
            setInterval(async () => {
                try {
                    const res = await fetch('/api/status');
                    const s = await res.json();
                    updateStatusUI(s);
                } catch(e) {}
            }, 3000);
            setInterval(checkAlgoStatus, 5000);
            setInterval(loadAccountInfo, 10000);
        });
    </script>
</body>
</html>
