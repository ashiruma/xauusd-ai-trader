<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>XAUUSD Quantitative Trading Terminal</title>
    <!-- TradingView Lightweight Charts v4.2.0 CDN -->
    <script src="https://unpkg.com/lightweight-charts@4.2.0/dist/lightweight-charts.standalone.production.js"></script>
    <style>
        :root {
            --bg-primary: #0b0e14;
            --bg-secondary: #121722;
            --bg-card: #182030;
            --bg-card-hover: #1e283d;
            --border: #243046;
            --border-highlight: #3b4d6e;
            --text-primary: #f1f5f9;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --accent-gold: #e5a93b;
            --accent-green: #10b981;
            --accent-red: #ef4444;
            --accent-blue: #3b82f6;
            --accent-purple: #8b5cf6;
            --accent-cyan: #06b6d4;
            --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            font-family: var(--font-family);
            font-size: 13px;
            line-height: 1.4;
            padding: 12px;
            overflow-x: hidden;
        }

        /* Top Header Bar */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 18px;
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 6px;
            margin-bottom: 12px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .header-title {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .header-title h1 {
            font-size: 16px;
            font-weight: 800;
            letter-spacing: 0.6px;
            color: var(--accent-gold);
            text-transform: uppercase;
        }

        .badges {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .badge {
            font-size: 11px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 4px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .badge-live { background: rgba(16, 185, 129, 0.2); color: var(--accent-green); border: 1px solid var(--accent-green); }
        .badge-paper { background: rgba(59, 130, 246, 0.2); color: var(--accent-blue); border: 1px solid var(--accent-blue); }
        .badge-ws-online { background: #10b981; color: #ffffff; border: 1px solid #059669; font-weight: 800; }
        .badge-ws-offline { background: rgba(239, 68, 68, 0.2); color: var(--accent-red); border: 1px solid var(--accent-red); }
        .badge-ws-recon { background: rgba(229, 169, 59, 0.2); color: var(--accent-gold); border: 1px solid var(--accent-gold); }

        .header-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn {
            font-family: inherit;
            font-size: 12px;
            font-weight: 700;
            padding: 7px 16px;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            border: none;
        }

        .btn-killswitch {
            background: #dc2626;
            color: #ffffff;
            box-shadow: 0 0 10px rgba(220, 38, 38, 0.3);
        }
        .btn-killswitch:hover { background: #b91c1c; }

        .btn-resume {
            background: #059669;
            color: #ffffff;
            box-shadow: 0 0 10px rgba(5, 150, 105, 0.3);
        }
        .btn-resume:hover { background: #047857; }

        .btn-secondary {
            background: var(--bg-card);
            color: var(--text-primary);
            border: 1px solid var(--border);
        }
        .btn-secondary:hover { background: var(--bg-card-hover); border-color: var(--border-highlight); }

        .btn-danger-sm {
            background: rgba(239, 68, 68, 0.2);
            color: var(--accent-red);
            border: 1px solid var(--accent-red);
            padding: 3px 8px;
            font-size: 11px;
            font-weight: 700;
            border-radius: 3px;
        }
        .btn-danger-sm:hover { background: var(--accent-red); color: #fff; }

        /* Real-Time Ticker & Ribbon */
        .ticker-ribbon {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 10px;
            margin-bottom: 12px;
        }

        .ribbon-card {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 10px 14px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .ribbon-label {
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .ribbon-value {
            font-size: 15px;
            font-weight: 800;
            font-family: monospace;
            color: var(--text-primary);
        }

        .val-bull { color: var(--accent-green) !important; }
        .val-bear { color: var(--accent-red) !important; }
        .val-gold { color: var(--accent-gold) !important; }
        .val-blue { color: var(--accent-blue) !important; }

        /* Main Workspace: Top Chart + Bottom Pane */
        .workspace-grid {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        /* Top Chart Container */
        .chart-panel {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 6px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 16px;
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
        }

        .panel-title {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .chart-legend {
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 11px;
            font-family: monospace;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .legend-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        #candlestick-chart {
            width: 100%;
            height: 380px;
            position: relative;
        }

        /* Bottom Tabbed Analytics & Execution Pane */
        .bottom-panel {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 6px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-height: 280px;
        }

        .tab-bar {
            display: flex;
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
        }

        .tab-btn {
            background: transparent;
            color: var(--text-secondary);
            border: none;
            padding: 10px 20px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            transition: all 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .tab-btn:hover {
            color: var(--text-primary);
            background: rgba(255, 255, 255, 0.02);
        }

        .tab-btn.active {
            color: var(--accent-gold);
            border-bottom-color: var(--accent-gold);
            background: var(--bg-secondary);
        }

        .tab-content {
            display: none;
            padding: 14px 18px;
            flex: 1;
        }

        .tab-content.active {
            display: block;
        }

        /* Tables */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            text-align: left;
        }

        .data-table th {
            color: var(--text-muted);
            font-weight: 600;
            padding: 8px 12px;
            border-bottom: 1px solid var(--border);
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 0.4px;
        }

        .data-table td {
            padding: 9px 12px;
            border-bottom: 1px solid rgba(36, 48, 70, 0.5);
            font-family: monospace;
        }

        .data-table tr:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        /* Equity Chart in Tab 1 */
        #equity-chart-container {
            width: 100%;
            height: 220px;
        }

        .equity-metrics-bar {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 12px;
            margin-bottom: 12px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }

        /* Risk Telemetry Tab 4 */
        .risk-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .risk-gauge-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 12px 16px;
        }

        .risk-gauge-title {
            font-size: 11px;
            color: var(--text-muted);
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 6px;
            display: flex;
            justify-content: space-between;
        }

        .progress-bar-bg {
            width: 100%;
            height: 8px;
            background: #243046;
            border-radius: 4px;
            overflow: hidden;
            margin-top: 6px;
        }

        .progress-bar-fill {
            height: 100%;
            background: var(--accent-green);
            border-radius: 4px;
            transition: width 0.3s ease;
        }

        /* Audit Lineage Modal */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(11, 14, 20, 0.85);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            backdrop-filter: blur(4px);
        }

        .modal-card {
            background: var(--bg-secondary);
            border: 1px solid var(--border-highlight);
            border-radius: 8px;
            width: 750px;
            max-width: 90vw;
            max-height: 85vh;
            overflow-y: auto;
            padding: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
            padding-bottom: 10px;
            margin-bottom: 14px;
        }

        .modal-header h3 {
            font-size: 14px;
            color: var(--accent-gold);
            font-weight: 700;
        }

        .close-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            font-size: 18px;
            cursor: pointer;
        }

        .lineage-step {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 10px 14px;
            margin-bottom: 10px;
        }

        .lineage-step-title {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .lineage-step-body {
            font-family: monospace;
            font-size: 11px;
            color: var(--text-primary);
            white-space: pre-wrap;
            word-break: break-all;
        }
    </style>
</head>
<body>

    <!-- Header Bar -->
    <div class="header">
        <div class="header-left">
            <div class="header-title">
                <h1>XAUUSD Quantitative Terminal</h1>
            </div>
            <div class="badges">
                <span id="badge-mode" class="badge badge-live">LIVE MODE</span>
                <span id="badge-data" class="badge badge-data">DATA: LIVE_MT5</span>
                <span id="badge-account" class="badge" style="background: rgba(229, 169, 59, 0.2); color: var(--accent-gold); border: 1px solid var(--accent-gold); cursor:pointer;" onclick="openConnectModal()" title="Click to Switch JustMarkets Account">ACC: #1200533810</span>
                <span id="badge-ws" class="badge badge-ws-recon">WS CONNECTING</span>
                <span id="badge-ai" class="badge badge-data">AI: Initializing...</span>
            </div>
        </div>
        <div class="header-right">
            <button id="btn-connect-account" class="btn" style="background:#059669; color:#fff; display:inline-flex; align-items:center; gap:6px; box-shadow:0 0 10px rgba(5,150,105,0.4);" onclick="openConnectModal()">Connect JustMarkets Account</button>
            <button id="btn-backtest" class="btn btn-secondary" onclick="triggerBacktest()">Run 15D Backtest</button>
            <button id="btn-kill" class="btn btn-killswitch" onclick="toggleEmergencyStop()">EMERGENCY STOP</button>
        </div>
    </div>

    <!-- Algo Trading Status Alert Banner -->
    <div id="banner-algo-trading" style="display:none; background:#7f1d1d; color:#fecaca; border:1px solid #b91c1c; padding:10px 16px; border-radius:6px; margin-bottom:12px; font-size:12px; font-weight:700; display:none; align-items:center; justify-content:space-between; box-shadow: 0 2px 8px rgba(0,0,0,0.3);">
        <div style="display:flex; align-items:center; gap:8px;">
            <span><strong>[WARNING] MT5 ALGO TRADING IS DISABLED IN TERMINAL:</strong> Automated orders are blocked by MetaTrader 5 security policy. Press <kbd style="background:#450a0a; padding:2px 8px; border-radius:4px; border:1px solid #f87171; color:#fff; font-family:monospace; font-size:12px;">Ctrl + E</kbd> in MetaTrader 5 (or click 'Algo Trading' toolbar button) to allow live execution.</span>
        </div>
        <button onclick="checkAlgoStatus()" style="background:#b91c1c; color:#fff; border:1px solid #ef4444; padding:5px 12px; border-radius:4px; cursor:pointer; font-size:11px; font-weight:700;">Re-check MT5</button>
    </div>

    <!-- Ticker & Indicator Ribbon -->
    <div class="ticker-ribbon">
        <div class="ribbon-card">
            <span class="ribbon-label">Spot Gold (Bid/Ask)</span>
            <span id="spot-price" class="ribbon-value val-gold">Syncing...</span>
            <span id="bid-ask" style="font-size: 11px; color: var(--text-muted);">-- / --</span>
        </div>
        <div class="ribbon-card">
            <span class="ribbon-label">Spread / Session</span>
            <span id="spread-pts" class="ribbon-value">-- pts</span>
            <span id="session-name" style="font-size: 11px; color: var(--accent-blue);">--</span>
        </div>
        <div class="ribbon-card">
            <span class="ribbon-label">Regime / Structure</span>
            <span id="regime-name" class="ribbon-value val-bull">Analyzing...</span>
            <span id="swing-hl" style="font-size: 11px; color: var(--text-muted);">-- / --</span>
        </div>
        <div class="ribbon-card">
            <span class="ribbon-label">ATR (14) / RSI (14)</span>
            <span id="atr-rsi" class="ribbon-value">-- | --</span>
            <span id="ema-stack" style="font-size: 11px; color: var(--text-muted);">E9/21/50/200</span>
        </div>
        <div class="ribbon-card">
            <span class="ribbon-label">Latest Fused Signal</span>
            <span id="sig-badge" class="ribbon-value">NO_TRADE</span>
            <span id="sig-strategy" style="font-size: 11px; color: var(--text-muted);">Awaiting Trigger</span>
        </div>
        <div class="ribbon-card">
            <span class="ribbon-label">Broker / Execution</span>
            <span id="broker-status" class="ribbon-value val-bull">Connecting...</span>
            <span id="last-update-time" style="font-size: 11px; color: var(--text-muted);">--:--:-- UTC</span>
        </div>
    </div>

    <!-- Main Workspace -->
    <div class="workspace-grid">
        
        <!-- Top Chart Panel -->
        <div class="chart-panel">
            <div class="panel-header">
                <div class="panel-title">
                    <span>XAUUSD · M15 Institutional Chart</span>
                    <span id="candle-live-info" style="font-family: monospace; font-size: 11px; color: var(--text-secondary);"></span>
                </div>
                <div class="chart-legend">
                    <div class="legend-item"><span class="legend-dot" style="background: #06b6d4;"></span><span>EMA 9</span></div>
                    <div class="legend-item"><span class="legend-dot" style="background: #f59e0b;"></span><span>EMA 21</span></div>
                    <div class="legend-item"><span class="legend-dot" style="background: #3b82f6;"></span><span>EMA 50</span></div>
                    <div class="legend-item"><span class="legend-dot" style="background: #8b5cf6;"></span><span>EMA 200</span></div>
                    <div class="legend-item"><span class="legend-dot" style="background: #eab308; border-radius: 0;"></span><span>Asian Range</span></div>
                </div>
            </div>
            <div id="candlestick-chart"></div>
        </div>

        <!-- Bottom Tabbed Panel -->
        <div class="bottom-panel">
            <div class="tab-bar">
                <button class="tab-btn active" onclick="switchTab('tab-positions')">Active Positions (<span id="pos-count">0</span>)</button>
                <button class="tab-btn" onclick="switchTab('tab-analytics')">Portfolio Equity & Performance</button>
                <button class="tab-btn" onclick="switchTab('tab-journal')">Auditable Trade Journal</button>
                <button class="tab-btn" onclick="switchTab('tab-risk')">Risk Governance Telemetry</button>
            </div>

            <!-- Tab 1: Active Positions -->
            <div id="tab-positions" class="tab-content active">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Ticket</th>
                            <th>Side</th>
                            <th>Lots</th>
                            <th>Entry Price</th>
                            <th>Current Price</th>
                            <th>Stop Loss</th>
                            <th>Take Profit</th>
                            <th>Floating P&L</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="positions-body">
                        <tr><td colspan="9" style="text-align:center; color: var(--text-secondary); padding: 18px;">No active open positions</td></tr>
                    </tbody>
                </table>
            </div>

            <!-- Tab 2: Equity & Performance Analytics -->
            <div id="tab-analytics" class="tab-content">
                <div class="equity-metrics-bar">
                    <div><span class="ribbon-label">Total Trades</span><div id="perf-total" class="ribbon-value">0</div></div>
                    <div><span class="ribbon-label">Win Rate</span><div id="perf-wr" class="ribbon-value">0.0%</div></div>
                    <div><span class="ribbon-label">Profit Factor</span><div id="perf-pf" class="ribbon-value">0.00</div></div>
                    <div><span class="ribbon-label">Net Profit</span><div id="perf-net" class="ribbon-value">$0.00</div></div>
                    <div><span class="ribbon-label">Max Drawdown</span><div id="perf-dd" class="ribbon-value">0.0%</div></div>
                    <div><span class="ribbon-label">Expectancy</span><div id="perf-exp" class="ribbon-value">$0.00</div></div>
                </div>
                <div id="equity-chart-container"></div>
            </div>

            <!-- Tab 3: Trade Journal -->
            <div id="tab-journal" class="tab-content">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Trade ID</th>
                            <th>Time</th>
                            <th>Strategy</th>
                            <th>Side</th>
                            <th>Lots</th>
                            <th>Entry</th>
                            <th>Exit</th>
                            <th>Net P&L</th>
                            <th>Reason</th>
                            <th>Audit Lineage</th>
                        </tr>
                    </thead>
                    <tbody id="journal-body">
                        <tr><td colspan="10" style="text-align:center; color: var(--text-secondary); padding: 18px;">Loading trade journal...</td></tr>
                    </tbody>
                </table>
            </div>

            <!-- Tab 4: Risk Governance Telemetry -->
            <div id="tab-risk" class="tab-content">
                <div class="risk-grid">
                    <div class="risk-gauge-card">
                        <div class="risk-gauge-title"><span>Daily Loss Limit</span><span id="risk-daily-val">$0.00 / 3.0%</span></div>
                        <div class="progress-bar-bg"><div id="risk-daily-bar" class="progress-bar-fill" style="width: 0%;"></div></div>
                    </div>
                    <div class="risk-gauge-card">
                        <div class="risk-gauge-title"><span>Account Drawdown</span><span id="risk-dd-val">0.0% / 8.0%</span></div>
                        <div class="progress-bar-bg"><div id="risk-dd-bar" class="progress-bar-fill" style="width: 0%;"></div></div>
                    </div>
                    <div class="risk-gauge-card">
                        <div class="risk-gauge-title"><span>Consecutive Losses Streak</span><span id="risk-consec-val">0 / 3</span></div>
                        <div class="progress-bar-bg"><div id="risk-consec-bar" class="progress-bar-fill" style="width: 0%;"></div></div>
                    </div>
                    <div class="risk-gauge-card">
                        <div class="risk-gauge-title"><span>Spread Tolerance</span><span id="risk-spread-val">25.0 / 35.0 pts</span></div>
                        <div class="progress-bar-bg"><div id="risk-spread-bar" class="progress-bar-fill" style="width: 71%;"></div></div>
                    </div>
                </div>

                <!-- Active Profit Collection & Maximizing Small Wins Section -->
                <div style="margin-top: 16px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 6px; padding: 14px 18px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 12px; border-bottom: 1px solid var(--border); padding-bottom: 8px;">
                        <div style="display:flex; align-items:center; gap:8px;">
                            <span style="font-weight:700; font-size:13px; color:var(--accent-gold); text-transform:uppercase; letter-spacing:0.5px;">Active Profit Collection Mechanism (Maximizing Small Wins)</span>
                        </div>
                        <span class="badge" style="background:rgba(16,185,129,0.2); color:var(--accent-green); border:1px solid var(--accent-green);">SYSTEM ACTIVE</span>
                    </div>

                    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; margin-bottom: 6px;">
                        <div style="background:var(--bg-secondary); border:1px solid var(--border); border-radius:6px; padding:12px;">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                                <span style="font-weight:700; font-size:12px; color:var(--text-primary);">Break-Even Protection</span>
                                <span style="font-weight:700; font-size:11px; color:var(--accent-green);">Locks +$0.25</span>
                            </div>
                            <div style="font-size:11px; color:var(--text-secondary); line-height:1.5;">
                                When floating profit reaches <strong>+80 points (+$0.80)</strong>, Stop Loss is immediately ratcheted to <strong>Entry + 25 points (+$0.25)</strong>, completely eliminating downside risk on the trade.
                            </div>
                        </div>

                        <div style="background:var(--bg-secondary); border:1px solid var(--border); border-radius:6px; padding:12px;">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                                <span style="font-weight:700; font-size:12px; color:var(--text-primary);">Dynamic Trailing Stop</span>
                                <span style="font-weight:700; font-size:11px; color:var(--accent-green);">Trails 80 pts</span>
                            </div>
                            <div style="font-size:11px; color:var(--text-secondary); line-height:1.5;">
                                Once floating profit expands past <strong>+150 points (+$1.50)</strong>, the bot trails Stop Loss <strong>80 points ($0.80)</strong> behind live market spot price, banking explosive moves without giving back profits.
                            </div>
                        </div>

                        <div style="background:var(--bg-secondary); border:1px solid var(--border); border-radius:6px; padding:12px;">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                                <span style="font-weight:700; font-size:12px; color:var(--text-primary);">JustMarkets Multi-User Policy</span>
                                <span style="font-weight:700; font-size:11px; color:var(--accent-gold);">$100.00 Min Deposit</span>
                            </div>
                            <div style="font-size:11px; color:var(--text-secondary); line-height:1.5;">
                                External JustMarkets accounts connecting to this terminal require a verified deposit of <strong>$100.00+ USD</strong>. Accounts with insufficient equity are safeguarded against execution until deposited.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>

    <!-- Lineage Inspection Modal -->
    <div id="lineage-modal" class="modal-overlay" onclick="closeModal(event)">
        <div class="modal-card" onclick="event.stopPropagation()">
            <div class="modal-header">
                <h3 id="modal-title">Trade Audit Lineage</h3>
                <button class="close-btn" onclick="closeModal()">&times;</button>
            </div>
            <div id="modal-content">Loading lineage...</div>
        </div>
    </div>

    <!-- Connect JustMarkets Account Modal -->
    <div id="connect-account-modal" class="modal-overlay" onclick="closeConnectModal(event)">
        <div class="modal-card" style="width: 560px;" onclick="event.stopPropagation()">
            <div class="modal-header">
                <div style="display:flex; align-items:center; gap:8px;">
                    <h3 style="margin:0; font-size:15px; color:var(--accent-gold);">Connect JustMarkets Account</h3>
                </div>
                <button class="close-btn" onclick="closeConnectModal()">&times;</button>
            </div>
            
            <!-- Requirement Callout Banner -->
            <div style="background:rgba(229, 169, 59, 0.12); border:1px solid var(--accent-gold); border-radius:6px; padding:12px; margin-bottom:16px;">
                <div style="display:flex; align-items:flex-start; gap:10px;">
                    <div>
                        <div style="font-weight:800; color:var(--accent-gold); font-size:12px; text-transform:uppercase; margin-bottom:4px;">
                            Minimum Deposit Required: $100.00 USD
                        </div>
                        <div style="color:var(--text-secondary); font-size:11px; line-height:1.4;">
                            To activate autonomous quantitative execution, your JustMarkets account must have at least <strong>$100.00 USD</strong> in equity or balance. Accounts below $100 are safely rejected from automated trading until deposited.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form -->
            <form id="connect-account-form" onsubmit="submitConnectAccount(event)">
                <div style="margin-bottom:14px;">
                    <label style="display:block; font-size:11px; font-weight:700; color:var(--text-muted); text-transform:uppercase; margin-bottom:6px;">
                        JustMarkets Account ID (Login)
                    </label>
                    <input type="number" id="input-account-login" placeholder="e.g. 1200533810" required
                           style="width:100%; background:var(--bg-secondary); border:1px solid var(--border); border-radius:4px; padding:9px 12px; color:var(--text-primary); font-family:monospace; font-size:13px; outline:none;">
                </div>

                <div style="margin-bottom:14px;">
                    <label style="display:block; font-size:11px; font-weight:700; color:var(--text-muted); text-transform:uppercase; margin-bottom:6px;">
                        Trading Password
                    </label>
                    <input type="password" id="input-account-password" placeholder="Enter MT5 trading password" required
                           style="width:100%; background:var(--bg-secondary); border:1px solid var(--border); border-radius:4px; padding:9px 12px; color:var(--text-primary); font-family:monospace; font-size:13px; outline:none;">
                </div>

                <div style="margin-bottom:18px;">
                    <label style="display:block; font-size:11px; font-weight:700; color:var(--text-muted); text-transform:uppercase; margin-bottom:6px;">
                        Broker Server
                    </label>
                    <select id="input-account-server"
                            style="width:100%; background:var(--bg-secondary); border:1px solid var(--border); border-radius:4px; padding:9px 12px; color:var(--text-primary); font-size:13px; outline:none;">
                        <option value="JustMarkets-Demo3">JustMarkets-Demo3 (Standard Demo)</option>
                        <option value="JustMarkets-Demo2">JustMarkets-Demo2</option>
                        <option value="JustMarkets-Demo">JustMarkets-Demo</option>
                        <option value="JustMarkets-Live">JustMarkets-Live (Real Account)</option>
                        <option value="JustMarkets-Live2">JustMarkets-Live2 (Real Account)</option>
                    </select>
                </div>

                <!-- Strategy & Sizing Summary -->
                <div style="background:var(--bg-card); border:1px solid var(--border); border-radius:6px; padding:12px; margin-bottom:16px;">
                    <div style="font-size:11px; font-weight:700; color:var(--text-muted); text-transform:uppercase; margin-bottom:6px;">
                        Automated Execution Safeguards
                    </div>
                    <ul style="padding-left:18px; font-size:11px; color:var(--text-secondary); line-height:1.6;">
                        <li><strong>Micro-Lot (0.01 lot)</strong> calibrated risk execution ($1.00/pt).</li>
                        <li><strong>Break-Even Lock:</strong> Moves SL to +$0.25 risk-free once +$0.80 profit is reached.</li>
                        <li><strong>Dynamic Trailing Stop:</strong> Automatically trails $0.80 behind market at +$1.50 profit.</li>
                        <li><strong>Hard SL & TP:</strong> Submitted server-side with FOK fill type on every order.</li>
                    </ul>
                </div>

                <!-- Response Alert Area -->
                <div id="connect-alert" style="display:none; padding:10px 14px; border-radius:4px; font-size:12px; margin-bottom:16px; line-height:1.4;"></div>

                <div style="display:flex; justify-content:flex-end; gap:10px;">
                    <button type="button" class="btn btn-secondary" onclick="closeConnectModal()">Cancel</button>
                    <button type="submit" id="btn-submit-connect" class="btn" style="background:#059669; color:#fff;">
                        Verify & Connect Account
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let ws = null;
        let isEmergencyStop = false;
        let candleChart = null;
        let candleSeries = null;
        let ema9Series = null;
        let ema21Series = null;
        let ema50Series = null;
        let ema200Series = null;
        let asianHighLine = null;
        let asianLowLine = null;
        let activeTradeLines = [];

        let equityChart = null;
        let equityAreaSeries = null;

        // Initialize Lightweight Charts
        function initCharts() {
            const chartElement = document.getElementById('candlestick-chart');
            candleChart = LightweightCharts.createChart(chartElement, {
                layout: {
                    background: { color: '#121722' },
                    textColor: '#94a3b8',
                },
                grid: {
                    vertLines: { color: 'rgba(36, 48, 70, 0.4)' },
                    horzLines: { color: 'rgba(36, 48, 70, 0.4)' },
                },
                crosshair: {
                    mode: LightweightCharts.CrosshairMode.Normal,
                },
                rightPriceScale: {
                    borderColor: '#243046',
                },
                timeScale: {
                    borderColor: '#243046',
                    timeVisible: true,
                    secondsVisible: false,
                },
            });

            candleSeries = candleChart.addCandlestickSeries({
                upColor: '#10b981',
                downColor: '#ef4444',
                borderUpColor: '#10b981',
                borderDownColor: '#ef4444',
                wickUpColor: '#10b981',
                wickDownColor: '#ef4444',
            });

            // EMA Series
            ema9Series = candleChart.addLineSeries({ color: '#06b6d4', lineWidth: 1, title: 'EMA 9' });
            ema21Series = candleChart.addLineSeries({ color: '#f59e0b', lineWidth: 2, title: 'EMA 21' });
            ema50Series = candleChart.addLineSeries({ color: '#3b82f6', lineWidth: 2, title: 'EMA 50' });
            ema200Series = candleChart.addLineSeries({ color: '#8b5cf6', lineWidth: 2, title: 'EMA 200' });

            // Initialize Equity Chart in Tab 2
            const eqElement = document.getElementById('equity-chart-container');
            equityChart = LightweightCharts.createChart(eqElement, {
                layout: { background: { color: '#121722' }, textColor: '#94a3b8' },
                grid: { vertLines: { color: 'rgba(36, 48, 70, 0.4)' }, horzLines: { color: 'rgba(36, 48, 70, 0.4)' } },
                rightPriceScale: { borderColor: '#243046' },
                timeScale: { borderColor: '#243046', timeVisible: true },
            });
            equityAreaSeries = equityChart.addAreaSeries({
                topColor: 'rgba(16, 185, 129, 0.4)',
                bottomColor: 'rgba(16, 185, 129, 0.02)',
                lineColor: '#10b981',
                lineWidth: 2,
            });

            // Responsive chart resize
            window.addEventListener('resize', () => {
                candleChart.applyOptions({ width: chartElement.clientWidth });
                equityChart.applyOptions({ width: eqElement.clientWidth });
            });
        }

        // Tab Switching
        function switchTab(tabId) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            event.target.classList.add('active');
            document.getElementById(tabId).classList.add('active');

            if (tabId === 'tab-analytics') {
                setTimeout(() => {
                    equityChart.applyOptions({ width: document.getElementById('equity-chart-container').clientWidth });
                    equityChart.timeScale().fitContent();
                }, 50);
            } else if (tabId === 'tab-journal') {
                loadJournal();
            }
        }

        // Load Initial Historical Candles
        async function loadHistoricalCandles() {
            try {
                const res = await fetch('/api/candles/history?count=200');
                const data = await res.json();
                if (data.candles && data.candles.length > 0) {
                    candleSeries.setData(data.candles);
                    const lastBar = data.candles[data.candles.length - 1];
                    window.lastHistoricalBarTime = lastBar.time;
                    window.activeCandle = {
                        time: lastBar.time,
                        open: lastBar.open,
                        high: lastBar.high,
                        low: lastBar.low,
                        close: lastBar.close
                    };

                    // Calculate basic EMAs on client for smooth visualization
                    const closes = data.candles.map(c => c.close);
                    const calcEma = (period) => {
                        const k = 2 / (period + 1);
                        let ema = closes[0];
                        return data.candles.map((c, i) => {
                            if (i === 0) ema = c.close;
                            else ema = c.close * k + ema * (1 - k);
                            return { time: c.time, value: parseFloat(ema.toFixed(2)) };
                        });
                    };

                    ema9Series.setData(calcEma(9));
                    ema21Series.setData(calcEma(21));
                    ema50Series.setData(calcEma(50));
                    ema200Series.setData(calcEma(200));

                    candleChart.timeScale().fitContent();
                }
            } catch (err) {
                console.error("Failed to load historical candles:", err);
            }
        }

        let wsPingInterval = null;

        // Connect WebSocket
        function connectWebSocket() {
            const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
            const wsUrl = `${protocol}//${window.location.host}/ws/terminal`;
            const badgeWs = document.getElementById('badge-ws');

            badgeWs.innerText = 'CONNECTING';
            badgeWs.className = 'badge badge-ws-recon';

            if (wsPingInterval) {
                clearInterval(wsPingInterval);
                wsPingInterval = null;
            }

            ws = new WebSocket(wsUrl);

            ws.onopen = () => {
                badgeWs.innerText = 'CONNECTED';
                badgeWs.className = 'badge badge-ws-online';

                // Keepalive heartbeat every 10s to prevent disconnects
                wsPingInterval = setInterval(() => {
                    if (ws && ws.readyState === WebSocket.OPEN) {
                        ws.send("ping");
                    }
                }, 10000);
            };

            ws.onmessage = (event) => {
                if (event.data === "pong") return;
                try {
                    const data = JSON.parse(event.data);
                    handleTelemetry(data);
                } catch (e) {
                    console.error("WS Parse error:", e);
                }
            };

            ws.onclose = () => {
                if (wsPingInterval) {
                    clearInterval(wsPingInterval);
                    wsPingInterval = null;
                }
                badgeWs.innerText = 'RECONNECTING';
                badgeWs.className = 'badge badge-ws-recon';
                setTimeout(connectWebSocket, 2000);
            };

            ws.onerror = (err) => {
                console.error("WebSocket error:", err);
                badgeWs.innerText = 'DISCONNECTED';
                badgeWs.className = 'badge badge-ws-offline';
                ws.close();
            };
        }

        // Handle Incoming WebSocket Messages
        function handleTelemetry(msg) {
            try {
                if (msg.type === 'INITIAL_STATE') {
                    if (msg.status) updateStatusUI(msg.status);
                    if (msg.market_state) updateMarketStateUI(msg.market_state);
                    if (msg.positions) updatePositionsUI(msg.positions);
                } else if (msg.type === 'TICK_STEP') {
                    if (msg.market_state) updateMarketStateUI(msg.market_state);
                    if (msg.open_positions) updatePositionsUI(msg.open_positions);
                    if (msg.fused_signal) updateSignalUI(msg.fused_signal);
                } else if (msg.type === 'POSITION_CLOSED') {
                    loadPositions();
                    loadJournal();
                    loadPerformance();
                }
            } catch (err) {
                console.error("handleTelemetry error:", err);
            }
        }

        // Periodic Algo Trading Status Poller
        async function checkAlgoStatus() {
            try {
                const res = await fetch('/api/algo-trading/status');
                const data = await res.json();
                const algoBanner = document.getElementById('banner-algo-trading');
                const brokerStatus = document.getElementById('broker-status');
                if (data.algo_trading_allowed) {
                    if (algoBanner) algoBanner.style.display = 'none';
                    if (brokerStatus && data.mt5_connected) {
                        brokerStatus.innerText = 'Live & Trading Active';
                        brokerStatus.className = 'ribbon-value val-bull';
                    }
                } else {
                    if (algoBanner) algoBanner.style.display = 'flex';
                    if (brokerStatus && data.mt5_connected) {
                        brokerStatus.innerText = 'MT5 Connected (Algo OFF)';
                        brokerStatus.className = 'ribbon-value val-gold';
                    }
                }
            } catch (e) {
                console.debug("Algo status check error:", e);
            }
        }

        // UI Updates
        function updateStatusUI(status) {
            document.getElementById('badge-mode').innerText = status.trading_mode + ' MODE';
            document.getElementById('badge-mode').className = 'badge ' + (status.trading_mode === 'LIVE' ? 'badge-live' : 'badge-paper');
            document.getElementById('badge-data').innerText = 'DATA: ' + status.data_mode;
            
            let aiText = 'AI: ' + status.ai_provider;
            if (status.ai_provider === 'DeterministicMockProvider') {
                aiText = 'AI: Gemini (Rule Fallback)';
            }
            document.getElementById('badge-ai').innerText = aiText;

            // Algo trading banner update
            const algoBanner = document.getElementById('banner-algo-trading');
            if (algoBanner) {
                if (status.mt5_algo_trading_allowed === false && status.trading_mode === 'LIVE') {
                    algoBanner.style.display = 'flex';
                } else {
                    algoBanner.style.display = 'none';
                }
            }

            isEmergencyStop = status.emergency_stop;
            const killBtn = document.getElementById('btn-kill');
            if (isEmergencyStop) {
                killBtn.className = 'btn btn-resume';
                killBtn.innerText = 'RESUME TRADING';
            } else {
                killBtn.className = 'btn btn-killswitch';
                killBtn.innerText = 'EMERGENCY STOP';
            }

            let brokerStatusText = 'Offline';
            let brokerStatusClass = 'ribbon-value val-bear';
            if (status.broker_connected) {
                if (status.mt5_algo_trading_allowed) {
                    brokerStatusText = 'Live & Trading Active';
                    brokerStatusClass = 'ribbon-value val-bull';
                } else {
                    brokerStatusText = 'MT5 Connected (Algo OFF)';
                    brokerStatusClass = 'ribbon-value val-gold';
                }
            }
            document.getElementById('broker-status').innerText = brokerStatusText;
            document.getElementById('broker-status').className = brokerStatusClass;

            if (status.performance) {
                updatePerformanceUI(status.performance);
            }
        }

        function updateMarketStateUI(mkt) {
            if (!mkt || !mkt.current_price) return;

            document.getElementById('spot-price').innerText = '$' + mkt.current_price.toFixed(2);
            document.getElementById('bid-ask').innerText = `${mkt.bid.toFixed(2)} / ${mkt.ask.toFixed(2)}`;
            document.getElementById('spread-pts').innerText = mkt.spread_points.toFixed(1) + ' pts';
            document.getElementById('session-name').innerText = mkt.session;
            document.getElementById('regime-name').innerText = mkt.regime;
            document.getElementById('regime-name').className = 'ribbon-value ' + (mkt.regime.includes('UP') ? 'val-bull' : (mkt.regime.includes('DOWN') ? 'val-bear' : 'val-gold'));

            document.getElementById('swing-hl').innerText = `$${(mkt.recent_swing_high || 0).toFixed(1)} / $${(mkt.recent_swing_low || 0).toFixed(1)}`;
            document.getElementById('atr-rsi').innerText = `$${mkt.atr_14.toFixed(2)} | RSI ${mkt.rsi_14.toFixed(1)}`;
            document.getElementById('ema-stack').innerText = `E9:${mkt.ema_9.toFixed(1)} E21:${mkt.ema_21.toFixed(1)} E50:${mkt.ema_50.toFixed(1)}`;
            
            const timeStr = mkt.timestamp ? mkt.timestamp.split('T')[1].slice(0, 8) + ' UTC' : '';
            document.getElementById('last-update-time').innerText = timeStr;

            // Live candle scrub on chart (M15 900s bucket alignment, preserving open, in-place OHLC update)
            if (candleSeries && mkt.timestamp) {
                try {
                    const rawSec = Math.floor(new Date(mkt.timestamp).getTime() / 1000);
                    const candleTime = Math.floor(rawSec / 900) * 900;
                    const curPrice = mkt.current_price;
                    const askPrice = mkt.ask || curPrice;
                    const bidPrice = mkt.bid || curPrice;

                    const lastHistTime = window.lastHistoricalBarTime || 0;
                    const effectiveTime = Math.max(candleTime, lastHistTime);

                    if (!window.activeCandle || window.activeCandle.time !== effectiveTime) {
                        window.activeCandle = {
                            time: effectiveTime,
                            open: curPrice,
                            high: Math.max(curPrice, askPrice),
                            low: Math.min(curPrice, bidPrice),
                            close: curPrice
                        };
                    } else {
                        window.activeCandle.high = Math.max(window.activeCandle.high, curPrice, askPrice);
                        window.activeCandle.low = Math.min(window.activeCandle.low, curPrice, bidPrice);
                        window.activeCandle.close = curPrice;
                    }
                    candleSeries.update(window.activeCandle);
                } catch (chartErr) {
                    console.warn("Chart candle update error intercepted safely:", chartErr);
                }
            }

            // Asian Range visual lines
            if (mkt.asian_range_high && mkt.asian_range_low) {
                if (asianHighLine) candleSeries.removePriceLine(asianHighLine);
                if (asianLowLine) candleSeries.removePriceLine(asianLowLine);
                asianHighLine = candleSeries.createPriceLine({
                    price: mkt.asian_range_high,
                    color: '#eab308',
                    lineWidth: 1,
                    lineStyle: LightweightCharts.LineStyle.Dashed,
                    axisLabelVisible: true,
                    title: 'Asian High'
                });
                asianLowLine = candleSeries.createPriceLine({
                    price: mkt.asian_range_low,
                    color: '#eab308',
                    lineWidth: 1,
                    lineStyle: LightweightCharts.LineStyle.Dashed,
                    axisLabelVisible: true,
                    title: 'Asian Low'
                });
            }
        }

        function updateSignalUI(sig) {
            if (!sig) return;
            const badge = document.getElementById('sig-badge');
            badge.innerText = sig.side;
            badge.className = 'ribbon-value ' + (sig.side === 'BUY' ? 'val-bull' : (sig.side === 'SELL' ? 'val-bear' : ''));
            document.getElementById('sig-strategy').innerText = `${sig.strategy_id} (Conf: ${sig.confidence.toFixed(2)})`;
        }

        function updatePositionsUI(positions) {
            document.getElementById('pos-count').innerText = positions.length;
            const pBody = document.getElementById('positions-body');

            // Clear old active trade lines on chart
            activeTradeLines.forEach(line => candleSeries.removePriceLine(line));
            activeTradeLines = [];

            if (positions && positions.length > 0) {
                pBody.innerHTML = positions.map(p => `
                    <tr>
                        <td>#${p.ticket}</td>
                        <td class="${p.side === 'BUY' ? 'val-bull' : 'val-bear'}"><strong>${p.side}</strong></td>
                        <td>${p.lots.toFixed(2)}</td>
                        <td>$${p.entry_price.toFixed(2)}</td>
                        <td>$${p.current_price.toFixed(2)}</td>
                        <td class="val-bear">$${p.stop_loss.toFixed(2)}</td>
                        <td class="val-bull">$${p.take_profit.toFixed(2)}</td>
                        <td class="${p.floating_pnl >= 0 ? 'val-bull' : 'val-bear'}"><strong>$${p.floating_pnl.toFixed(2)}</strong></td>
                        <td><button class="btn-danger-sm" onclick="closePosition(${p.ticket})">CLOSE</button></td>
                    </tr>
                `).join('');

                // Draw active trade entry, SL, TP on chart
                const active = positions[0];
                activeTradeLines.push(candleSeries.createPriceLine({
                    price: active.entry_price,
                    color: '#10b981',
                    lineWidth: 2,
                    lineStyle: LightweightCharts.LineStyle.Solid,
                    axisLabelVisible: true,
                    title: `ENTRY #${active.ticket}`
                }));
                activeTradeLines.push(candleSeries.createPriceLine({
                    price: active.stop_loss,
                    color: '#ef4444',
                    lineWidth: 2,
                    lineStyle: LightweightCharts.LineStyle.Dashed,
                    axisLabelVisible: true,
                    title: 'STOP LOSS'
                }));
                activeTradeLines.push(candleSeries.createPriceLine({
                    price: active.take_profit,
                    color: '#10b981',
                    lineWidth: 2,
                    lineStyle: LightweightCharts.LineStyle.Dashed,
                    axisLabelVisible: true,
                    title: 'TAKE PROFIT'
                }));
            } else {
                pBody.innerHTML = '<tr><td colspan="9" style="text-align:center; color: var(--text-secondary); padding: 18px;">No active open positions</td></tr>';
            }
        }

        function updatePerformanceUI(perf) {
            document.getElementById('perf-total').innerText = perf.total_trades;
            document.getElementById('perf-wr').innerText = perf.win_rate_pct.toFixed(1) + '%';
            document.getElementById('perf-pf').innerText = perf.profit_factor.toFixed(2);
            document.getElementById('perf-net').innerText = '$' + perf.net_profit.toFixed(2);
            document.getElementById('perf-net').className = 'ribbon-value ' + (perf.net_profit >= 0 ? 'val-bull' : 'val-bear');
            document.getElementById('perf-dd').innerText = perf.max_drawdown_pct.toFixed(1) + '%';
            document.getElementById('perf-exp').innerText = '$' + perf.expectancy_usd.toFixed(2);

            // Update Risk gauges in Tab 4
            const maxDd = 8.0;
            const ddPct = Math.min(100, (perf.max_drawdown_pct / maxDd) * 100);
            document.getElementById('risk-dd-val').innerText = `${perf.max_drawdown_pct.toFixed(2)}% / ${maxDd}%`;
            document.getElementById('risk-dd-bar').style.width = ddPct + '%';
            document.getElementById('risk-dd-bar').style.backgroundColor = ddPct > 75 ? '#ef4444' : (ddPct > 50 ? '#f59e0b' : '#10b981');
        }

        // Close Position Action
        async function closePosition(ticket) {
            if (!confirm(`Are you sure you want to manually close position #${ticket}?`)) return;
            try {
                const res = await fetch(`/api/positions/close/${ticket}`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    alert(`Position #${ticket} successfully closed! Net P&L: $${data.trade.pnl}`);
                } else {
                    alert(`Failed to close position: ${data.detail || 'Unknown error'}`);
                }
            } catch (err) {
                alert(`Error closing position: ${err}`);
            }
        }

        // Toggle Emergency Stop
        async function toggleEmergencyStop() {
            const newState = !isEmergencyStop;
            try {
                const res = await fetch('/api/risk/emergency-stop', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        enabled: newState,
                        reason: newState ? 'Manual Emergency Stop triggered from Web Terminal' : 'Manual Resume triggered from Web Terminal'
                    })
                });
                const data = await res.json();
                isEmergencyStop = data.emergency_stop;
                const killBtn = document.getElementById('btn-kill');
                if (isEmergencyStop) {
                    killBtn.className = 'btn btn-resume';
                    killBtn.innerText = 'RESUME TRADING';
                } else {
                    killBtn.className = 'btn btn-killswitch';
                    killBtn.innerText = 'EMERGENCY STOP';
                }
            } catch (err) {
                alert("Failed to toggle Emergency Stop: " + err);
            }
        }

        // Trigger Backtest
        async function triggerBacktest() {
            const btn = document.getElementById('btn-backtest');
            btn.innerText = 'Simulating...';
            btn.disabled = true;
            try {
                const res = await fetch('/api/trading/backtest', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ days: 15, base_price: 2650.0 })
                });
                const data = await res.json();
                alert(`Backtest Finished!\nData: ${data.summary.data_source}\nTrades: ${data.summary.total_trades}\nNet P&L: $${data.summary.net_profit} (WR: ${data.performance.win_rate_pct}%, PF: ${data.performance.profit_factor})`);
                
                // Render Equity Curve on Tab 2
                if (data.equity_curve && data.equity_curve.length > 0) {
                    const eqData = data.equity_curve.map(e => ({
                        time: Math.floor(new Date(e.time).getTime() / 1000),
                        value: e.equity
                    }));
                    equityAreaSeries.setData(eqData);
                    equityChart.timeScale().fitContent();
                }
                updatePerformanceUI(data.performance);
            } catch (err) {
                alert("Backtest failed: " + err);
            } finally {
                btn.innerText = 'Run 15D Backtest';
                btn.disabled = false;
            }
        }

        // Load Trade Journal & Lineage Inspector
        async function loadJournal() {
            const jBody = document.getElementById('journal-body');
            try {
                const res = await fetch('/api/journal?limit=30');
                const trades = await res.json();
                if (trades && trades.length > 0) {
                    jBody.innerHTML = trades.map(t => `
                        <tr>
                            <td>${t.trade_id}</td>
                            <td>${t.entry_time ? t.entry_time.split('T')[1].slice(0, 8) : ''}</td>
                            <td>${t.strategy_id}</td>
                            <td class="${t.side === 'BUY' ? 'val-bull' : 'val-bear'}">${t.side}</td>
                            <td>${t.lots.toFixed(2)}</td>
                            <td>$${t.entry_price.toFixed(2)}</td>
                            <td>$${t.exit_price.toFixed(2)}</td>
                            <td class="${t.pnl >= 0 ? 'val-bull' : 'val-bear'}"><strong>$${t.pnl.toFixed(2)}</strong></td>
                            <td>${t.exit_reason}</td>
                            <td><button class="btn btn-secondary" style="padding: 2px 8px; font-size: 11px;" onclick="inspectLineage('${t.trade_id}')">INSPECT</button></td>
                        </tr>
                    `).join('');
                } else {
                    jBody.innerHTML = '<tr><td colspan="10" style="text-align:center; color: var(--text-secondary); padding: 18px;">No trades recorded in journal</td></tr>';
                }
            } catch (e) {
                jBody.innerHTML = `<tr><td colspan="10" style="text-align:center; color: var(--accent-red); padding: 18px;">Failed to load journal: ${e}</td></tr>`;
            }
        }

        // Inspect Lineage Modal
        async function inspectLineage(tradeId) {
            const modal = document.getElementById('lineage-modal');
            const title = document.getElementById('modal-title');
            const content = document.getElementById('modal-content');
            title.innerText = `Audit Lineage: ${tradeId}`;
            modal.style.display = 'flex';
            content.innerHTML = '<div style="color: var(--text-secondary); padding: 20px; text-align: center;">Fetching auditable lineage from SQLite...</div>';

            try {
                const res = await fetch(`/api/journal/${tradeId}`);
                const data = await res.json();
                content.innerHTML = `
                    <div class="lineage-step">
                        <div class="lineage-step-title">1. Executed Trade</div>
                        <div class="lineage-step-body">Ticket: #${data.trade?.ticket} | Side: ${data.trade?.side} | Lots: ${data.trade?.lots} | Entry: $${data.trade?.entry_price} | Exit: $${data.trade?.exit_price} | Net: $${data.trade?.pnl} (${data.trade?.exit_reason})</div>
                    </div>
                    <div class="lineage-step">
                        <div class="lineage-step-title">2. Execution Order & Slippage</div>
                        <div class="lineage-step-body">${data.order ? JSON.stringify(data.order, null, 2) : 'Direct paper execution'}</div>
                    </div>
                    <div class="lineage-step">
                        <div class="lineage-step-title">3. Deterministic Risk Gate Decision</div>
                        <div class="lineage-step-body">${data.risk_decision ? `Approved: ${data.risk_decision.approved} | Reason: ${data.risk_decision.reason} | Stop Dist: ${data.risk_decision.stop_distance_points} pts | Account Equity: $${data.risk_decision.account_equity}` : 'Pre-trade risk audit record'}</div>
                    </div>
                    <div class="lineage-step">
                        <div class="lineage-step-title">4. Fused Signal & Multi-Agent Scoring</div>
                        <div class="lineage-step-body">${data.signal ? `Strategy: ${data.signal.strategy_id} | Confidence: ${data.signal.confidence} | Reasons: ${data.signal.reasons_json || JSON.stringify(data.signal.reasons)}` : 'Signal record'}</div>
                    </div>
                    <div class="lineage-step">
                        <div class="lineage-step-title">5. AI Analyst Decision Support</div>
                        <div class="lineage-step-body">${data.ai_decision ? `Model Decision: ${data.ai_decision.decision} | Valid: ${data.ai_decision.setup_valid} | Confidence: ${data.ai_decision.confidence} | Provider: ${data.ai_decision.provider}\nReasons: ${data.ai_decision.reasons_json || ''}` : 'AI Decision Support Record'}</div>
                    </div>
                `;
            } catch (err) {
                content.innerHTML = `<div style="color: var(--accent-red); padding: 20px;">Failed to fetch lineage: ${err}</div>`;
            }
        }

        function closeModal() {
            document.getElementById('lineage-modal').style.display = 'none';
        }

        // Connect JustMarkets Account Modal Handlers
        function openConnectModal() {
            const modal = document.getElementById('connect-account-modal');
            const alertBox = document.getElementById('connect-alert');
            alertBox.style.display = 'none';
            alertBox.innerHTML = '';
            modal.style.display = 'flex';
        }

        function closeConnectModal(event) {
            if (event && event.target && event.target.id !== 'connect-account-modal' && !event.target.classList.contains('close-btn')) return;
            document.getElementById('connect-account-modal').style.display = 'none';
        }

        async function submitConnectAccount(e) {
            e.preventDefault();
            const login = document.getElementById('input-account-login').value.trim();
            const password = document.getElementById('input-account-password').value.trim();
            const server = document.getElementById('input-account-server').value.trim();
            const submitBtn = document.getElementById('btn-submit-connect');
            const alertBox = document.getElementById('connect-alert');

            if (!login || !password) {
                alertBox.style.display = 'block';
                alertBox.style.background = '#7f1d1d';
                alertBox.style.color = '#fecaca';
                alertBox.style.border = '1px solid #b91c1c';
                alertBox.innerHTML = '<strong>Error:</strong> Please enter Account ID and Trading Password.';
                return;
            }

            submitBtn.disabled = true;
            submitBtn.innerText = 'Verifying Account & Deposit...';
            alertBox.style.display = 'block';
            alertBox.style.background = 'rgba(59, 130, 246, 0.2)';
            alertBox.style.color = '#93c5fd';
            alertBox.style.border = '1px solid #3b82f6';
            alertBox.innerHTML = 'Connecting to JustMarkets terminal & verifying $100.00+ deposit requirement...';

            try {
                const res = await fetch('/api/account/connect', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        login: parseInt(login),
                        password: password,
                        server: server
                    })
                });
                const data = await res.json();

                if (data.success) {
                    alertBox.style.background = 'rgba(16, 185, 129, 0.2)';
                    alertBox.style.color = '#6ee7b7';
                    alertBox.style.border = '1px solid #10b981';
                    alertBox.innerHTML = `
                        <div style="font-weight:700; margin-bottom:4px;">ACCOUNT CONNECTED SUCCESSFULLY</div>
                        <div><strong>Account:</strong> #${data.login} (${data.server})</div>
                        <div><strong>Verified Equity:</strong> $${data.equity ? data.equity.toFixed(2) : '--'} (Balance: $${data.balance ? data.balance.toFixed(2) : '--'})</div>
                        <div style="margin-top:6px; color:#a7f3d0;">Autonomous Micro-Lot Execution & Profit Ratchet Activated</div>
                    `;
                    document.getElementById('badge-account').innerText = `ACC: #${data.login} ($${data.equity ? data.equity.toFixed(2) : '--'})`;
                    // Refresh status
                    setTimeout(() => {
                        closeConnectModal();
                        fetch('/api/status').then(r => r.json()).then(updateStatusUI);
                        loadAccountInfo();
                    }, 2500);
                } else {
                    alertBox.style.background = '#7f1d1d';
                    alertBox.style.color = '#fecaca';
                    alertBox.style.border = '1px solid #b91c1c';
                    let depositNote = '';
                    if (data.deposit_required) {
                        depositNote = `
                            <div style="margin-top:8px; padding-top:8px; border-top:1px solid #991b1b; font-size:11px;">
                                [DEPOSIT REQUIRED] Current Equity is <strong>$${data.current_equity.toFixed(2)}</strong>. 
                                A minimum deposit of <strong>$${data.deposit_required.toFixed(2)} USD</strong> is required to activate autonomous bot execution.
                                Please deposit into your JustMarkets account and reconnect.
                            </div>
                        `;
                    }
                    alertBox.innerHTML = `
                        <div style="font-weight:700; margin-bottom:4px;">CONNECTION REJECTED</div>
                        <div>${data.message || 'Authentication or validation failed.'}</div>
                        ${depositNote}
                    `;
                }
            } catch (err) {
                alertBox.style.background = '#7f1d1d';
                alertBox.style.color = '#fecaca';
                alertBox.style.border = '1px solid #b91c1c';
                alertBox.innerHTML = `<strong>Network Error:</strong> ${err.message || err}`;
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerText = 'Verify & Connect Account';
            }
        }

        async function loadAccountInfo() {
            try {
                const res = await fetch('/api/account/info');
                const data = await res.json();
                const accBadge = document.getElementById('badge-account');
                if (accBadge && data.login) {
                    accBadge.innerText = `ACC: #${data.login} ($${data.equity ? data.equity.toFixed(2) : '0.00'})`;
                }
            } catch (e) {
                console.debug("Error loading account info:", e);
            }
        }

        // Initialize application on page load
        window.addEventListener('DOMContentLoaded', async () => {
            initCharts();
            await loadHistoricalCandles();
            connectWebSocket();
            checkAlgoStatus();
            loadAccountInfo();
            // Fallback poll every 4 seconds to guarantee state refresh
            setInterval(async () => {
                try {
                    const res = await fetch('/api/status');
                    const s = await res.json();
                    updateStatusUI(s);
                } catch(e) {}
            }, 4000);
            setInterval(checkAlgoStatus, 5000);
            setInterval(loadAccountInfo, 10000);
        });
    </script>
</body>
</html>
