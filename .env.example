# ==========================================
# XAUUSD Quantitative Trading System Configuration
# ==========================================

# Trading Operation Mode: PAPER (default) | LIVE | BACKTEST
TRADING_MODE=PAPER
DATA_MODE=PAPER_FEED

# Global Emergency Stop (true to halt all entries immediately)
EMERGENCY_STOP=false

# Risk Engine Thresholds
RISK__MAX_RISK_PER_TRADE_PCT=1.0
RISK__MAX_DAILY_LOSS_PCT=3.0
RISK__MAX_DRAWDOWN_PCT=6.0
RISK__MAX_CONSECUTIVE_LOSSES=3
RISK__MAX_OPEN_POSITIONS=1
RISK__MAX_SPREAD_POINTS=35.0
RISK__MAX_SLIPPAGE_POINTS=20.0
RISK__MIN_RISK_REWARD_RATIO=1.5
RISK__MIN_STOP_DISTANCE_POINTS=15.0
RISK__MAX_STOP_DISTANCE_POINTS=1000.0
RISK__SESSION_RESTRICTIONS_ENABLED=true
RISK__NEWS_RESTRICTIONS_ENABLED=true
RISK__NEWS_PRE_WINDOW_MINUTES=15
RISK__NEWS_POST_WINDOW_MINUTES=15
RISK__DUPLICATE_SIGNAL_WINDOW_SECONDS=300
RISK__SIGNAL_EXPIRY_SECONDS=180

# MetaTrader 5 Broker Configuration
MT5__LOGIN=12345678
MT5__PASSWORD=YourBrokerPasswordHere
MT5__SERVER=MetaQuotes-Demo
MT5__MAGIC_NUMBER=108824
MT5__SYMBOL=XAUUSD
# Optional MT5 executable path if installed in non-standard location
# MT5__PATH="C:\\Program Files\\MetaTrader 5\\terminal64.exe"

# AI Provider Configuration
# Supported providers: mock | openai | anthropic | gemini | openrouter
AI__PROVIDER=mock
AI__MODEL=gpt-4o
AI__API_KEY=
AI__TEMPERATURE=0.1

# SQLite Database Location
DB_PATH=data/xauusd_trader.db

# API & Dashboard
API_HOST=127.0.0.1
API_PORT=8000
