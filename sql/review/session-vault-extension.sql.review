 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('velarion_private.session_operation(text,text,text,uuid,uuid,timestamp with time zone,timestamp with time zone,uuid,text,text)') AND md5(prosrc)='eafb82052b189531af7dbc8e9fb5068f' AND proowner='velarion_owner'::regrole AND proconfig=ARRAY['search_path=""'] AND prosecdef=false AND NOT proleakproof AND provolatile='v' AND prorettype='jsonb'::regtype AND NOT proretset AND coalesce(proacl,acldefault('f',proowner))::text='{velarion_owner=X/velarion_owner}') THEN RAISE EXCEPTION 'Vault dependency routine fingerprint drift: velarion_private.session_operation'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('velarion_private.require_study_for_subject(uuid,text,uuid,text,text)') AND md5(prosrc)='0fae465521e6000334d864d1ce390d34' AND proowner='velarion_owner'::regrole AND proconfig=ARRAY['search_path=""'] AND prosecdef=false AND NOT proleakproof AND provolatile='v' AND prorettype='void'::regtype AND NOT proretset AND coalesce(proacl,acldefault('f',proowner))::text='{velarion_owner=X/velarion_owner}') THEN RAISE EXCEPTION 'Vault dependency routine fingerprint drift: velarion_private.require_study_for_subject'; END IF;
