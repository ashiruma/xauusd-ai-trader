 IF (SELECT count(*) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='velarion_api')<>11 THEN RAISE EXCEPTION 'Vault routine surface/overload drift'; END IF;
 IF (SELECT count(*) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='velarion_private')<>17 THEN RAISE EXCEPTION 'Vault routine surface/overload drift'; END IF;
 IF EXISTS(SELECT 1 FROM pg_namespace n WHERE n.nspname IN ('velarion_private','velarion_api') AND n.nspowner<>'velarion_owner'::regrole) OR EXISTS(SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname IN ('velarion_private','velarion_api') AND (c.relowner<>'velarion_owner'::regrole OR (c.relkind='r' AND NOT c.relrowsecurity))) THEN RAISE EXCEPTION 'Dependency owner/RLS drift'; END IF;
 IF EXISTS(SELECT 1 FROM pg_namespace n CROSS JOIN LATERAL aclexplode(coalesce(n.nspacl,acldefault('n',n.nspowner))) a WHERE n.nspname IN ('velarion_private','velarion_api') AND a.grantee<>n.nspowner AND NOT(n.nspname='velarion_api' AND a.grantee='velarion_bff'::regrole AND a.privilege_type='USAGE' AND NOT a.is_grantable)) THEN RAISE EXCEPTION 'Dependency schema ACL drift'; END IF;
 IF EXISTS(SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace CROSS JOIN LATERAL aclexplode(coalesce(c.relacl,acldefault('r',c.relowner))) a WHERE n.nspname IN ('velarion_private','velarion_api') AND a.grantee<>c.relowner) OR EXISTS(SELECT 1 FROM pg_attribute t JOIN pg_class c ON c.oid=t.attrelid JOIN pg_namespace n ON n.oid=c.relnamespace CROSS JOIN LATERAL aclexplode(t.attacl) a WHERE n.nspname IN ('velarion_private','velarion_api') AND a.grantee<>c.relowner) THEN RAISE EXCEPTION 'Dependency relation/column ACL drift'; END IF;
 IF EXISTS(SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace CROSS JOIN LATERAL aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a WHERE n.nspname IN ('velarion_private','velarion_api') AND a.grantee<>p.proowner AND NOT(n.nspname='velarion_api' AND a.grantee='velarion_bff'::regrole AND a.privilege_type='EXECUTE' AND NOT a.is_grantable)) THEN RAISE EXCEPTION 'Dependency routine ACL drift'; END IF;
 IF EXISTS(SELECT 1 FROM pg_default_acl d CROSS JOIN LATERAL aclexplode(d.defaclacl) a WHERE d.defaclrole='velarion_owner'::regrole AND a.grantee<>d.defaclrole) THEN RAISE EXCEPTION 'Dependency default ACL drift'; END IF;
 IF EXISTS(SELECT 1 FROM velarion_private.auth_issuers) OR EXISTS(SELECT 1 FROM velarion_private.identities) OR EXISTS(SELECT 1 FROM velarion_private.learners) OR EXISTS(SELECT 1 FROM velarion_private.app_sessions) OR EXISTS(SELECT 1 FROM velarion_private.app_session_handles) OR EXISTS(SELECT 1 FROM velarion_private.session_admission_attempts) OR EXISTS(SELECT 1 FROM velarion_private.onboarding_waivers) OR EXISTS(SELECT 1 FROM velarion_private.delivery_controls WHERE enabled) THEN RAISE EXCEPTION 'Expected empty enrollment/pass/session and delivery-off baseline'; END IF;
 IF to_regclass('velarion_private.admission_vault') IS NOT NULL THEN RAISE EXCEPTION 'Vault extension collision'; END IF;
END $baseline$;
-- END GENERATED POST-ONBOARDING GUARDS
CREATE TABLE velarion_private.admission_vault (
 capability_hash text PRIMARY KEY CHECK(capability_hash ~ '^[0-9a-f]{64}$'),
 revision bigint NOT NULL CHECK(revision>0), expires_at timestamptz NOT NULL,
 iv text NOT NULL CHECK(length(iv)<=32), auth_tag text NOT NULL CHECK(length(auth_tag)<=32),
 ciphertext text NOT NULL CHECK(length(ciphertext)<=90000), consumed boolean NOT NULL DEFAULT false,
 updated_at timestamptz NOT NULL DEFAULT clock_timestamp()
);
ALTER TABLE velarion_private.admission_vault ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON velarion_private.admission_vault FROM PUBLIC, anon, authenticated, service_role, velarion_bff, velarion_broker_ingest, velarion_execution_worker;
GRANT SELECT,INSERT,UPDATE,DELETE ON velarion_private.admission_vault TO velarion_owner;
CREATE INDEX admission_vault_purge_idx ON velarion_private.admission_vault(expires_at) WHERE NOT consumed;
CREATE FUNCTION velarion_api.admission_vault_create(p_id text,p_revision bigint,p_exp_ms bigint,p_iv text,p_tag text,p_cipher text) RETURNS TABLE(status text,revision bigint,expires_at bigint,iv text,tag text,ciphertext text)
 LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
DECLARE old velarion_private.admission_vault%ROWTYPE; exp timestamptz;
BEGIN
 IF p_id !~ '^[0-9a-f]{64}$' OR p_revision<>1 OR p_exp_ms<=((extract(epoch from clock_timestamp())*1000)::bigint) OR p_exp_ms>((extract(epoch from clock_timestamp())*1000)::bigint)+28860000 OR length(p_iv)>32 OR length(p_tag)>32 OR length(p_cipher)>90000 THEN RETURN QUERY SELECT 'invalid'::text,0::bigint,0::bigint,''::text,''::text,''::text; RETURN; END IF;
 exp:=to_timestamp(p_exp_ms::numeric/1000);
 INSERT INTO velarion_private.admission_vault(capability_hash,revision,expires_at,iv,auth_tag,ciphertext) VALUES(p_id,1,exp,p_iv,p_tag,p_cipher) ON CONFLICT DO NOTHING;
 IF FOUND THEN RETURN QUERY SELECT 'ok'::text,1::bigint,p_exp_ms,p_iv,p_tag,p_cipher; RETURN; END IF;
 SELECT * INTO old FROM velarion_private.admission_vault WHERE capability_hash=p_id FOR UPDATE;
 RETURN QUERY SELECT 'exists'::text,old.revision,(extract(epoch from old.expires_at)*1000)::bigint,old.iv,old.auth_tag,old.ciphertext;
END $$;
CREATE FUNCTION velarion_api.admission_vault_read(p_id text) RETURNS TABLE(status text,revision bigint,expires_at bigint,iv text,tag text,ciphertext text)
 LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
DECLARE r velarion_private.admission_vault%ROWTYPE;
BEGIN
 IF p_id !~ '^[0-9a-f]{64}$' THEN RETURN QUERY SELECT 'missing'::text,0::bigint,0::bigint,''::text,''::text,''::text; RETURN; END IF;
 SELECT * INTO r FROM velarion_private.admission_vault WHERE capability_hash=p_id;
 IF NOT FOUND THEN RETURN QUERY SELECT 'missing'::text,0::bigint,0::bigint,''::text,''::text,''::text; RETURN; END IF;
 IF r.consumed THEN RETURN QUERY SELECT 'consumed'::text,r.revision,0::bigint,''::text,''::text,''::text; RETURN; END IF;
 IF r.expires_at<=clock_timestamp() THEN RETURN QUERY SELECT 'expired'::text,r.revision,0::bigint,''::text,''::text,''::text; RETURN; END IF;
 RETURN QUERY SELECT 'ok'::text,r.revision,(extract(epoch from r.expires_at)*1000)::bigint,r.iv,r.auth_tag,r.ciphertext;
END $$;
CREATE FUNCTION velarion_api.admission_vault_cas(p_id text,p_expected bigint,p_revision bigint,p_exp_ms bigint,p_iv text,p_tag text,p_cipher text) RETURNS TABLE(status text,revision bigint,expires_at bigint,iv text,tag text,ciphertext text)
 LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
DECLARE r velarion_private.admission_vault%ROWTYPE; exp timestamptz;
BEGIN
 SELECT * INTO r FROM velarion_private.admission_vault WHERE capability_hash=p_id FOR UPDATE;
 IF NOT FOUND OR r.consumed THEN RETURN QUERY SELECT 'missing'::text,0::bigint,0::bigint,''::text,''::text,''::text; RETURN; END IF;
 IF r.expires_at<=clock_timestamp() THEN UPDATE velarion_private.admission_vault SET consumed=true,iv='',auth_tag='',ciphertext='',updated_at=clock_timestamp() WHERE capability_hash=p_id; RETURN QUERY SELECT 'expired'::text,r.revision,0::bigint,''::text,''::text,''::text; RETURN; END IF;
 IF r.revision<>p_expected THEN RETURN QUERY SELECT 'conflict'::text,r.revision,(extract(epoch from r.expires_at)*1000)::bigint,r.iv,r.auth_tag,r.ciphertext; RETURN; END IF;
 IF p_revision<>p_expected+1 OR p_exp_ms<=((extract(epoch from clock_timestamp())*1000)::bigint) OR p_exp_ms>((extract(epoch from clock_timestamp())*1000)::bigint)+28860000 OR length(p_iv)>32 OR length(p_tag)>32 OR length(p_cipher)>90000 THEN RETURN QUERY SELECT 'invalid'::text,r.revision,0::bigint,''::text,''::text,''::text; RETURN; END IF;
 exp:=to_timestamp(p_exp_ms::numeric/1000);
 UPDATE velarion_private.admission_vault SET revision=p_revision,expires_at=exp,iv=p_iv,auth_tag=p_tag,ciphertext=p_cipher,updated_at=clock_timestamp() WHERE capability_hash=p_id RETURNING * INTO r;
 RETURN QUERY SELECT 'ok'::text,r.revision,(extract(epoch from r.expires_at)*1000)::bigint,r.iv,r.auth_tag,r.ciphertext;
END $$;
CREATE FUNCTION velarion_api.admission_vault_remove(p_id text) RETURNS TABLE(status text,revision bigint,expires_at bigint,iv text,tag text,ciphertext text)
 LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
DECLARE r velarion_private.admission_vault%ROWTYPE;
BEGIN
 SELECT * INTO r FROM velarion_private.admission_vault WHERE capability_hash=p_id FOR UPDATE;
 IF NOT FOUND THEN RETURN QUERY SELECT 'missing'::text,0::bigint,0::bigint,''::text,''::text,''::text; RETURN; END IF;
 IF r.consumed THEN RETURN QUERY SELECT 'consumed'::text,r.revision,0::bigint,''::text,''::text,''::text; RETURN; END IF;
 IF r.expires_at<=clock_timestamp() THEN UPDATE velarion_private.admission_vault SET consumed=true,iv='',auth_tag='',ciphertext='',updated_at=clock_timestamp() WHERE capability_hash=p_id; RETURN QUERY SELECT 'expired'::text,r.revision,0::bigint,''::text,''::text,''::text; RETURN; END IF;
 UPDATE velarion_private.admission_vault SET consumed=true,iv='',auth_tag='',ciphertext='',updated_at=clock_timestamp() WHERE capability_hash=p_id;
 RETURN QUERY SELECT 'removed'::text,r.revision,(extract(epoch from r.expires_at)*1000)::bigint,r.iv,r.auth_tag,r.ciphertext;
END $$;
CREATE FUNCTION velarion_api.admission_vault_purge(p_limit integer) RETURNS integer
 LANGUAGE plpgsql SECURITY DEFINER SET search_path='' AS $$
DECLARE n integer;
BEGIN
 IF p_limit IS NULL OR p_limit<1 OR p_limit>500 THEN RAISE EXCEPTION 'invalid purge bound'; END IF;
 WITH targets AS (SELECT capability_hash FROM velarion_private.admission_vault WHERE NOT consumed AND expires_at<=clock_timestamp() ORDER BY expires_at LIMIT p_limit FOR UPDATE SKIP LOCKED)
 UPDATE velarion_private.admission_vault v SET consumed=true,iv='',auth_tag='',ciphertext='',updated_at=clock_timestamp() FROM targets t WHERE v.capability_hash=t.capability_hash;
 GET DIAGNOSTICS n=ROW_COUNT; RETURN n;
END $$;
REVOKE ALL ON FUNCTION velarion_api.admission_vault_create(text,bigint,bigint,text,text,text),velarion_api.admission_vault_read(text),velarion_api.admission_vault_cas(text,bigint,bigint,bigint,text,text,text),velarion_api.admission_vault_remove(text),velarion_api.admission_vault_purge(integer) FROM PUBLIC,anon,authenticated,service_role,velarion_broker_ingest,velarion_execution_worker;
GRANT EXECUTE ON FUNCTION velarion_api.admission_vault_create(text,bigint,bigint,text,text,text),velarion_api.admission_vault_read(text),velarion_api.admission_vault_cas(text,bigint,bigint,bigint,text,text,text),velarion_api.admission_vault_remove(text),velarion_api.admission_vault_purge(integer) TO velarion_bff;
RESET ROLE;
REVOKE velarion_owner FROM postgres GRANTED BY postgres;
DO $role_restored$
BEGIN
 IF current_user<>'postgres' OR session_user<>'postgres'
 OR pg_has_role('postgres','velarion_owner','SET') THEN RAISE EXCEPTION 'Owner authority cleanup failed'; END IF;
 IF (SELECT count(*) FROM pg_auth_members WHERE roleid IN (SELECT oid FROM pg_roles WHERE rolname IN ('velarion_owner','velarion_bff','velarion_broker_ingest','velarion_execution_worker')))<>4
 OR EXISTS(SELECT 1 FROM pg_auth_members WHERE roleid IN (SELECT oid FROM pg_roles WHERE rolname IN ('velarion_owner','velarion_bff','velarion_broker_ingest','velarion_execution_worker')) AND (member<>'postgres'::regrole OR grantor<>'supabase_admin'::regrole OR NOT admin_option OR inherit_option OR set_option))
 OR EXISTS(SELECT 1 FROM pg_auth_members WHERE member IN (SELECT oid FROM pg_roles WHERE rolname IN ('velarion_owner','velarion_bff','velarion_broker_ingest','velarion_execution_worker'))) THEN RAISE EXCEPTION 'Restored membership drift'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='postgres' AND NOT rolsuper AND rolcanlogin AND rolcreaterole AND rolcreatedb AND rolbypassrls AND rolinherit) THEN RAISE EXCEPTION 'Restored deployment profile drift'; END IF;
 IF (SELECT count(*) FROM pg_roles WHERE left(rolname,9)='velarion_')<>4
 OR (SELECT count(*) FROM pg_roles WHERE rolname IN ('velarion_owner','velarion_bff','velarion_broker_ingest','velarion_execution_worker') AND NOT rolcanlogin AND NOT rolsuper AND NOT rolbypassrls AND NOT rolcreaterole AND NOT rolcreatedb AND NOT rolreplication AND rolinherit AND rolconfig IS NULL)<>4 THEN RAISE EXCEPTION 'Restored application profile drift'; END IF;
END $role_restored$;
COMMIT;
