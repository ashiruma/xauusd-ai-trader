 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('velarion_private.require_admission_identity(text,uuid,uuid,timestamp with time zone,timestamp with time zone,boolean)') AND md5(prosrc)='c93e4e7c9be81fa3fe0680adf88981de' AND proowner='velarion_owner'::regrole AND proconfig=ARRAY['search_path=""'] AND prosecdef=false AND NOT proleakproof AND provolatile='v' AND prorettype='uuid'::regtype AND NOT proretset AND coalesce(proacl,acldefault('f',proowner))::text='{velarion_owner=X/velarion_owner}') THEN RAISE EXCEPTION 'Vault dependency routine fingerprint drift: velarion_private.require_admission_identity'; END IF;
 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('velarion_private.require_app_handle(text,text,uuid,uuid,timestamp with time zone,timestamp with time zone,boolean)') AND md5(prosrc)='5198f2a0534e43f78f53e27774093d9a' AND proowner='velarion_owner'::regrole AND proconfig=ARRAY['search_path=""'] AND prosecdef=false AND NOT proleakproof AND provolatile='v' AND prorettype='uuid'::regtype AND NOT proretset AND coalesce(proacl,acldefault('f',proowner))::text='{velarion_owner=X/velarion_owner}') THEN RAISE EXCEPTION 'Vault dependency routine fingerprint drift: velarion_private.require_app_handle'; END IF;
