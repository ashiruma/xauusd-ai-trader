# ==============================================================================
# VELARION MARKETS - WINDOWS VPS PRODUCTION CONFIGURATION
# ==============================================================================
# Copy this file to .env in your repository root on the Windows VPS:
#   copy deploy\vps\vps.env.example .env

# --- Execution & Operation Mode ---
TRADING_MODE=LIVE
DATA_MODE=LIVE_MT5
EMERGENCY_STOP=false

# --- Broker MT5 Terminal Settings ---
# Use the exact symbol provided by JustMarkets (e.g. XAUUSD.m on Standard/Cent accounts)
MT5__SYMBOL=XAUUSD.m
MT5__MAGIC_NUMBER=108824
MT5__TIMEOUT_MS=60000

# Optional: Hardcode MT5 account credentials if running headless without saved profile
# MT5__LOGIN=1200533810
# MT5__SERVER=JustMarkets-Demo3
# MT5__PASSWORD=YourBrokerPasswordHere
# MT5__PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Deterministic Risk Guardrails ---
# Maximum risk percentage of account equity per trade (e.g. 1.5%)
RISK__MAX_RISK_PER_TRADE_PCT=1.5
# Maximum daily loss before trading halts for the day (e.g. 3.0%)
RISK__MAX_DAILY_LOSS_PCT=3.0
# Maximum total account drawdown before emergency halt (e.g. 8.0%)
RISK__MAX_DRAWDOWN_PCT=8.0
# Maximum concurrent open positions (Strict capital preservation: 1 position)
RISK__MAX_OPEN_POSITIONS=1
# Maximum acceptable spread in points (35 points = $0.35 on Gold)
RISK__MAX_SPREAD_POINTS=35.0
# Consecutive losses cooldown trigger (2 consecutive losses triggers 4h pause)
RISK__MAX_CONSECUTIVE_LOSSES=2
# Allow 0.01 micro lot execution on smaller accounts
RISK__ALLOW_MIN_LOT_OVERRIDE=true

# --- Active Profit Protection & Run Maximization ---
RISK__ENABLE_BREAK_EVEN=true
RISK__BREAK_EVEN_TRIGGER_POINTS=80.0
RISK__BREAK_EVEN_LOCK_POINTS=25.0
RISK__ENABLE_TRAILING_STOP=true
RISK__TRAILING_TRIGGER_POINTS=150.0
RISK__TRAILING_DISTANCE_POINTS=80.0

# --- Server & Networking ---
# Host on 127.0.0.1 if using Cloudflare Tunnel (recommended), or 0.0.0.0 for reverse proxy
API_HOST=127.0.0.1
API_PORT=8000
DB_PATH=data/xauusd_trader.db

# --- Security Authentication ---
# Set a strong random secret key. Pass this same key in Vercel as VELARION_INTERNAL_API_KEY
# to prevent unauthorized external access to your trading daemon.
VELARION_INTERNAL_API_KEY=generate-a-strong-secret-key-here

# --- AI Decision Support ---
AI__PROVIDER=mock
AI__MODEL=gpt-4o
