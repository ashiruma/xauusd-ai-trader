# REVIEW EXAMPLE ONLY. Not installed, not active, and never a Production configuration.
# Intended for Vercel Node.js Functions after separately approved SQL/runtime setup.
VELARION_RELEASE_ENVIRONMENT=staging
# Both must be the exact separately approved canonical staging HTTPS origin, with no trailing slash.
VELARION_APP_ORIGIN=
VELARION_STAGING_APP_ORIGIN=
# Must equal https://akhftbbszejafxpoxiem.supabase.co; other projects are rejected.
VELARION_SUPABASE_URL=
# Project publishable key only; sb_publishable_ prefix. Never service-role/secret/legacy admin keys.
VELARION_SUPABASE_PUBLISHABLE_KEY=
# SECRET: dedicated least-privilege velarion_bff_runtime LOGIN; no role/credential is created here.
# Use the exact staging shared transaction-pooler host from the separately authorized project Connect dialog.
# Username: velarion_bff_runtime.akhftbbszejafxpoxiem; port 6543; database postgres.
# URL must have no query parameters. Driver enforces certificate/hostname-verified TLS (verify-full).
# Trust must validate under the runtime's CA roots; never bypass verification to make a connection work.
# max=1 per warm function, prepare=false, max_pipeline=1; each call has transaction-local timeouts.
VELARION_BFF_DATABASE_URL=
# SECRET: independent cryptographically random 32-byte AES key encoded as canonical base64.
# Same approved key across staging instances/deployments that must share sessions; never NEXT_PUBLIC_.
# No key is supplied. Custody, rotation/invalidation and restoration procedures need separate approval.
VELARION_ADMISSION_VAULT_KEY=
# No filesystem directory, additional KV account, service-role key or browser provider-token cookie is used.
# No enrollment, email authorization, priority UUID override, course-delivery or trading-enable variables exist.
# Auth must require email confirmation. Approve exact Site URL and /auth/callback allowlist separately.
# Logical TTL is enforced; indexed bounded purge wipes expired ciphertext during auth work.
# Compact consumed hashes remain as replay tombstones; idle cleanup/capacity policy is still operational work.
